---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import Compartir from '../../components/Compartir.astro';
import CabeceraFoto from '../../components/vidrio/CabeceraFoto.astro';
import Circulo from '../../components/vidrio/Circulo.astro';
import Sellar from '../../components/pasaporte/Sellar.astro';
import Iniciales from '../../components/Iniciales.astro';
import { CATEGORIAS } from '../../lib/lugares';
import { fotoDe } from '../../lib/fotos';

export async function getStaticPaths() {
  const lugares = await getCollection('lugares');
  return lugares.map((lugar) => ({ params: { id: lugar.id }, props: { lugar } }));
}

const { lugar } = Astro.props;
const { Content } = await render(lugar);
const rutas = (await getCollection('rutas'))
  .filter((r) => r.data.paradas.some((p) => p.id === lugar.id))
  .sort((a, b) => a.data.orden - b.data.orden);
const { nombre, categoria, epoca, resumen, dato, fuentes, revision, direccion, negocio } = lugar.data;
const foto = fotoDe(lugar.id);
// Las personas ligadas a este lugar
const personajes = (await getCollection('personajes'))
  .filter((p) => p.data.lugares.some((l) => l.id === lugar.id))
  .sort((a, b) => a.data.nacimiento.anio - b.data.nacimiento.anio);
// Las recetas que se pueden probar aquí
const recetas = (await getCollection('recetas'))
  .filter((r) => r.data.dondeProbar.some((l) => l.id === lugar.id))
  .sort((a, b) => a.data.orden - b.data.orden);
const tipo = CATEGORIAS[categoria];
---

<Base titulo={nombre} descripcion={resumen} imagen={`/tarjetas/og/lugares/${lugar.id}.jpg`}>
  <CabeceraFoto foto={foto} alt={nombre} titulo={nombre} meta={`${tipo.singular} · ${epoca}`} icono={tipo.icono}>
    <Fragment slot="controles">
      <Circulo icono="caret-left" etiqueta="Volver" href="/mapa" data-volver="" />
      <span class="controles__derecha">
        <Circulo icono="map-pin" etiqueta="Ver en el mapa" href={`/mapa?lugar=${lugar.id}`} />
        <Compartir
          enlace={`/lugares/${lugar.id}`}
          tarjeta={`/tarjetas/lugares/${lugar.id}.jpg`}
          titulo={nombre}
          texto={dato ?? resumen}
        />
      </span>
    </Fragment>
  </CabeceraFoto>

  <!-- El contenido es sólido: se monta sobre la foto como una hoja -->
  <article class="hoja">
    <p class="resumen">{resumen}</p>

    <!-- El Pasaporte va primero: es lo que se hace estando aquí -->
    <Sellar id={lugar.id} nombre={nombre} categoria={categoria} coordenadas={lugar.data.coordenadas} />

    {
      (direccion || negocio) && (
        <ul class="celdas">
          {direccion && (
            <li>
              <span class="celda">
                <Icono nombre="map-pin-line" class="celda__icono" />
                <span class="celda__texto">{direccion}</span>
              </span>
            </li>
          )}
          {negocio && (
            <li>
              <span class="celda">
                <Icono nombre="storefront" class="celda__icono" />
                <span class="celda__texto">Es un negocio local: confirma su horario y que siga abierto antes de ir.</span>
              </span>
            </li>
          )}
        </ul>
      )
    }

    {
      dato && (
        <aside class="dato" aria-labelledby="titulo-dato">
          <h2 id="titulo-dato">¿Sabías que…?</h2>
          <p>{dato}</p>
        </aside>
      )
    }

    <div class="cuerpo">
      <Content />
    </div>

    {
      rutas.length > 0 && (
        <section class="grupo" aria-labelledby="titulo-rutas">
          <h2 class="grupo__titulo" id="titulo-rutas">
            Está en {rutas.length === 1 ? 'esta ruta' : 'estas rutas'}
          </h2>
          <ul class="celdas">
            {rutas.map((r) => (
              <li>
                <a class="celda" href={`/rutas/${r.id}`}>
                  <Icono nombre={r.data.modo === 'carro' ? 'car-simple' : 'footprints'} class="celda__icono" />
                  <span class="celda__texto">{r.data.nombre}</span>
                  <Icono nombre="caret-right" class="celda__flecha" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      personajes.length > 0 && (
        <section class="grupo" aria-labelledby="titulo-personajes">
          <h2 class="grupo__titulo" id="titulo-personajes">
            {personajes.length === 1 ? 'Su personaje' : 'Sus personajes'}
          </h2>
          <ul class="celdas">
            {personajes.map((p) => (
              <li>
                <a class="celda" href={`/personajes/${p.id}`}>
                  <Iniciales iniciales={p.data.iniciales} tamano="chico" />
                  <span class="celda__texto">
                    {p.data.nombre}
                    <small>{p.data.oficio}</small>
                  </span>
                  <Icono nombre="caret-right" class="celda__flecha" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      recetas.length > 0 && (
        <section class="grupo" aria-labelledby="titulo-recetas">
          <h2 class="grupo__titulo" id="titulo-recetas">
            Aquí se prueba
          </h2>
          <ul class="celdas">
            {recetas.map((r) => (
              <li>
                <a class="celda" href={`/recetario/${r.id}`}>
                  <Icono nombre={r.data.icono} class="celda__icono" />
                  <span class="celda__texto">
                    {r.data.nombre}
                    <small>Cómo se prepara, en el Recetario vivo</small>
                  </span>
                  <Icono nombre="caret-right" class="celda__flecha" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="grupo" aria-labelledby="titulo-fuentes">
      <h2 class="grupo__titulo" id="titulo-fuentes">Fuentes</h2>
      <ul class="celdas">
        {
          fuentes.map((f) => (
            <li>
              <a class="celda" href={f.url} rel="noopener noreferrer">
                <Icono nombre="link-simple" class="celda__icono" />
                <span class="celda__texto">{f.titulo}</span>
                <Icono nombre="arrow-up-right" class="celda__flecha" />
              </a>
            </li>
          ))
        }
        <li>
          <a class="celda" href={`/tarjetas/lugares/${lugar.id}.jpg`} download={`${lugar.id}.jpg`}>
            <Icono nombre="download-simple" class="celda__icono" />
            <span class="celda__texto">Descargar la tarjeta para compartir</span>
          </a>
        </li>
      </ul>
      <p class="nota">
        {
          revision === 'pendiente' &&
            'Ficha en revisión histórica: los datos vienen de las fuentes citadas y antes del lanzamiento los validará una persona experta en historia de Popayán. '
        }
        ¿Ves un error? Escríbenos desde <a href="/acerca">Acerca</a>.
        {
          foto && (
            <>
              {' '}
              Foto: <a href={foto.credito.fuente} rel="noopener noreferrer">{foto.credito.autor}</a>, {foto.credito.licencia}, vía
              Wikimedia Commons.
            </>
          )
        }
      </p>
    </section>
  </article>
</Base>

<script>
  // "Volver" regresa a donde se venía si fue dentro del sitio; si no, al mapa
  for (const volver of document.querySelectorAll<HTMLAnchorElement>('[data-volver]')) {
    volver.addEventListener('click', (e) => {
      if (document.referrer && new URL(document.referrer).origin === location.origin && history.length > 1) {
        e.preventDefault();
        history.back();
      }
    });
  }
</script>

<style>
  .controles__derecha {
    display: flex;
    gap: 10px;
  }

  .hoja {
    position: relative;
    display: grid;
    gap: 2rem;
    margin-top: -1.75rem;
    padding: 2rem var(--margen) 0;
    border-radius: var(--radio-l) var(--radio-l) 0 0;
    background: var(--fondo);
  }

  .hoja > :global(*) {
    width: 100%;
    max-width: 42rem;
    margin-inline: auto;
  }

  /* La entradilla, como en una revista: la letra del Quijote de Ibarra, en cursiva */
  .resumen {
    font-family: var(--fuente-titulos);
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: -0.008em;
    text-wrap: pretty;
  }

  /* El dato, como una cita destacada entre dos filetes */
  .dato {
    position: relative;
    display: grid;
    gap: 0.75rem;
    padding: 1.4rem 0 1.5rem 3.4rem;
    border-block: 1px solid var(--separador);
    border-top: 2px solid var(--acento);
  }

  .dato::before {
    content: '“';
    position: absolute;
    top: 0.6rem;
    left: -0.2rem;
    font-family: var(--fuente-titulos);
    font-size: 5.5rem;
    line-height: 1;
    color: var(--acento);
  }

  .dato h2 {
    font-family: var(--fuente);
    font-size: var(--t-nota);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--acento);
  }

  .dato p {
    font-family: var(--fuente-titulos);
    font-size: clamp(1.4rem, 1.2rem + 0.9vw, 1.85rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.22;
    text-wrap: pretty;
  }

  .cuerpo {
    display: grid;
    gap: 1rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    letter-spacing: -0.012em;
  }

  /* Capitular en el primer párrafo del texto, en teja */
  .cuerpo > :global(p:first-of-type::first-letter) {
    float: left;
    margin: 0.06em 0.1em 0 0;
    font-family: var(--fuente-titulos);
    font-size: 3.6em;
    font-weight: 600;
    line-height: 0.8;
    color: var(--acento);
  }

</style>
