---
/**
 * Portada inmersiva: la ciudad contada en escenas a pantalla completa que responden al desplazamiento, como
 * las páginas de producto de Apple, pero con Popayán como protagonista. Cada escena es un lugar real y cada
 * frase sale de una ficha con fuentes.
 *
 * Sin JavaScript, o con "reducir movimiento", las escenas se ven quietas y completas, una debajo de otra.
 * Con movimiento, el guion de abajo añade la clase "inmersivo": las escenas se alargan, el escenario queda
 * fijo y lo que pasa en él avanza con el desplazamiento.
 */
import { getCollection, getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Sello from '../components/pasaporte/Sello.astro';
import { rutasOrdenadas, formatearDuracion } from '../lib/rutas';
import { diaDelMes, nombreDelMes } from '../lib/fechas';
import { fotoDe, lineaCredito } from '../lib/fotos';
import { CATEGORIAS } from '../lib/lugares';
import { momento } from '../lib/semana-santa';

const parque = fotoDe('parque-caldas')!;
const torre = fotoDe('torre-del-reloj')!;
const morro = fotoDe('morro-de-tulcan')!;
const puente = fotoDe('puente-del-humilladero')!;
const rutas = (await rutasOrdenadas()).map((r) => ({ ...r, foto: fotoDe(r.ruta.data.foto) }));
const eventos = (await getCollection('eventos')).sort((a, b) => a.data.inicio.localeCompare(b.data.inicio));
const hitos = (await getCollection('hitos')).sort((a, b) => a.data.anio - b.data.anio);
const lugares = await getCollection('lugares');
const datos = lugares.filter((l) => l.data.dato).map((l) => ({ id: l.id, nombre: l.data.nombre, dato: l.data.dato! }));
const recetas = (await getCollection('recetas')).sort((a, b) => a.data.orden - b.data.orden);
const morroFicha = (await getEntry('lugares', 'morro-de-tulcan'))!;
const semanaSanta = momento(new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Bogota' }).format(new Date()));
// Seis sellos de muestra, de seis clases de lugar, para la libreta de la escena del Pasaporte
const muestra = ['torre-del-reloj', 'la-ermita', 'puente-del-humilladero', 'casa-museo-mosquera', 'la-fresa', 'hacienda-calibio']
  .map((id) => lugares.find((l) => l.id === id)!)
  .filter(Boolean);
---

<Base seccion="inicio">
  <!-- ---------- 1. Apertura: el parque, a sangre; al bajar, la foto se recoge en un marco ---------- -->
  <section class="escena apertura" data-escena="apertura">
    <div class="escenario">
      <div class="apertura__marco" data-marco>
        <Picture
          src={parque.src}
          formats={['avif', 'webp']}
          widths={[640, 1024, 1600, 2200]}
          sizes="100vw"
          alt="El Parque Caldas con la Torre del Reloj y la cúpula de la Catedral, bajo un cielo azul"
          class="escena__foto apertura__foto"
          loading="eager"
          fetchpriority="high"
        />
        <div class="velo velo--abajo" aria-hidden="true"></div>
        <a class="credito" href={parque.credito.fuente} rel="noopener noreferrer">Foto: {lineaCredito(parque.credito)}</a>
      </div>

      <a class="marca-movil vidrio" href="/" aria-label="Popayán Interactiva, inicio">
        <span class="marca-movil__torre isotipo" aria-hidden="true"></span>
        <span>Popayán Interactiva</span>
      </a>

      <div class="apertura__texto" data-apertura-texto>
        <h1>Popayán, <em>contada lugar por lugar</em></h1>
        <p>El Centro Histórico y sus alrededores en rutas, con historias que citan sus fuentes y un mapa que funciona sin señal.</p>
        <div class="acciones">
          <a class="boton boton--lleno" href="#rutas">Empezar una ruta</a>
          <a class="boton boton--vidrio vidrio" href="/mapa">
            <Icono nombre="map-trifold" />
            Abrir el mapa
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- 2. La torre: al bajar, la manecilla da la vuelta hasta la hora de Popayán ---------- -->
  <section class="escena torre" aria-labelledby="titulo-torre" data-escena="torre">
    <div class="escenario">
      <Picture
        src={torre.src}
        formats={['avif', 'webp']}
        widths={[640, 1024, 1600, 2200]}
        sizes="100vw"
        alt="La Torre del Reloj, blanca, con su esfera de una sola manecilla, junto al Parque Caldas"
        class="escena__foto torre__foto"
        data-torre-foto
      />
      <div class="velo velo--torre" aria-hidden="true"></div>

      <div class="torre__reloj vidrio" aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <circle cx="60" cy="60" r="54" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.5"></circle>
          {
            Array.from({ length: 12 }, (_, i) => (
              <line
                x1="60"
                y1="10"
                x2="60"
                y2={i % 3 === 0 ? 20 : 16}
                stroke="currentColor"
                stroke-width={i % 3 === 0 ? 3 : 1.8}
                stroke-linecap="round"
                transform={`rotate(${i * 30} 60 60)`}
              />
            ))
          }
          <g data-manecilla transform="rotate(0 60 60)">
            <path d="M60 64 L57 60 L60 24 L63 60 Z" fill="currentColor"></path>
          </g>
          <circle cx="60" cy="60" r="4.5" fill="var(--maiz)"></circle>
        </svg>
      </div>

      <div class="torre__frases">
        <h2 id="titulo-torre" class="frase" data-frase>Desde 1737, <em>una sola manecilla.</em></h2>
        <p class="frase" data-frase>La de las horas. Los minutos no los marca.</p>
        <p class="frase" data-frase>Por eso los guías dicen que en la Ciudad Blanca <em>el tiempo no pasa.</em></p>
      </div>

      <a class="torre__hora vidrio" href="/lugares/torre-del-reloj" data-torre-hora>
        <span data-hora>La hora de Popayán</span>
        <span class="torre__ir">La Torre del Reloj <Icono nombre="arrow-right" /></span>
      </a>
      <a class="credito" href={torre.credito.fuente} rel="noopener noreferrer">Foto: {lineaCredito(torre.credito)}</a>
    </div>
  </section>

  <!-- ---------- 3. Rutas: en escritorio, la pista corre de lado mientras se baja ---------- -->
  <section class="escena rutas" id="rutas" aria-labelledby="titulo-rutas" data-escena="rutas">
    <div class="escenario rutas__escenario">
      <div class="rutas__cabeza">
        <h2 id="titulo-rutas">Ocho rutas. <em>Una ciudad.</em></h2>
        <p>Siete a pie por el centro y una en carro por las haciendas. Cada parada, con su historia.</p>
        <a class="enlace" href="/planificador">Arma tu plan de 1 a 3 días <Icono nombre="arrow-right" /></a>
      </div>
      <ol class="pista" data-pista aria-label="Rutas">
        {
          rutas.map(({ ruta, paradas, minutos, foto }, i) => (
            <li class="pista__item">
              <a class="tarjeta" href={`/rutas/${ruta.id}`}>
                {foto && (
                  <Picture
                    src={foto.src}
                    formats={['avif', 'webp']}
                    widths={[480, 800, 1100]}
                    sizes="(min-width: 48rem) 380px, 78vw"
                    alt=""
                    class="tarjeta__foto"
                    data-transicion={`foto-ruta-${ruta.id}`}
                  />
                )}
                <span class="tarjeta__numero" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="tarjeta__pie vidrio">
                  <span class="tarjeta__nombre">{ruta.data.nombre}</span>
                  <span class="tarjeta__datos">
                    {paradas.length} paradas · {formatearDuracion(minutos)} {ruta.data.modo === 'carro' ? 'en carro' : 'a pie'}
                  </span>
                </span>
                {foto && <span class="solo-lector">Foto: {lineaCredito(foto.credito)}</span>}
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ---------- El Pasaporte: la libreta se abre y los sellos caen, uno por bajada ---------- -->
  <section class="escena pasaporte" aria-labelledby="titulo-pasaporte" data-escena="pasaporte">
    <div class="escenario pasaporte__escenario">
      <div class="libreta" aria-hidden="true">
        <div class="libreta__hoja sello-ganado">
          {
            muestra.map((l) => (
              <span class="libreta__sello" data-pp-sello>
                <Sello id={l.id} clave={`portada-${l.id}`} tipo={CATEGORIAS[l.data.categoria].singular} icono={CATEGORIAS[l.data.categoria].icono} />
              </span>
            ))
          }
        </div>
        <div class="libreta__tapa" data-pp-tapa>
          <span class="libreta__escudo isotipo"></span>
          <span class="libreta__nombre">Pasaporte <em>de Popayán</em></span>
        </div>
      </div>

      <div class="pasaporte__texto" data-pp-texto>
        <h2 id="titulo-pasaporte" class="pasaporte__titulo">Un sello <em>por cada lugar.</em></h2>
        <p class="pasaporte__bajada">
          Solo se gana estando allí, con la ubicación del teléfono o con el código QR del lugar. Sin cuentas: tus sellos
          viven en tu teléfono.
        </p>
        <p class="pasaporte__cuenta" data-pasaporte-texto data-total={lugares.length}>
          {lugares.length} lugares por sellar
        </p>
        <a class="boton boton--lleno" href="/pasaporte">Abrir mi pasaporte</a>
      </div>
    </div>
  </section>

  <!-- ---------- 4. El Morro: parece una colina; la foto se acerca y resulta ser una pirámide ---------- -->
  <section class="escena morro" aria-labelledby="titulo-morro" data-escena="morro">
    <div class="escenario">
      <Picture
        src={morro.src}
        formats={['avif', 'webp']}
        widths={[640, 1024, 1600, 2200]}
        sizes="100vw"
        alt="El Morro de Tulcán, verde, con la estatua ecuestre en la cima, sobre los tejados de Popayán"
        class="escena__foto morro__foto"
        data-morro-foto
      />
      <div class="velo velo--abajo" aria-hidden="true"></div>
      <p class="morro__frase morro__frase--a" data-morro-a>Parece una colina.</p>
      <h2 id="titulo-morro" class="morro__frase morro__frase--b" data-morro-b>Es una <em>pirámide.</em></h2>
      <a class="morro__nota vidrio" href="/lugares/morro-de-tulcan" data-morro-nota>
        <span>{morroFicha.data.resumen}</span>
        <span class="morro__ir">El Morro de Tulcán <Icono nombre="arrow-right" /></span>
      </a>
      <a class="credito" href={morro.credito.fuente} rel="noopener noreferrer">Foto: {lineaCredito(morro.credito)}</a>
    </div>
  </section>

  <!-- ---------- 5. Semana Santa: la noche, con la cuenta que corre ---------- -->
  <a class="escena semana" href="/semana-santa" aria-labelledby="titulo-semana" data-escena="semana">
    <div class="escenario semana__escenario">
      <span class="semana__luz" aria-hidden="true"></span>
      <h2 id="titulo-semana" class="semana__titulo">Semana Santa</h2>
      <p class="semana__cuenta" data-semana-santa data-dias={semanaSanta.tipo === 'antes' ? semanaSanta.dias : ''}>
        {
          semanaSanta.tipo === 'antes' ? (
            <>
              <span class="semana__cifra" data-cifra>
                {semanaSanta.dias}
              </span>
              <span class="semana__texto">días para el Domingo de Ramos</span>
            </>
          ) : (
            <span class="semana__texto">Es Semana Santa: mira la procesión de hoy</span>
          )
        }
      </p>
      <span class="semana__ir">Las procesiones, noche por noche <Icono nombre="arrow-right" /></span>
    </div>
  </a>

  <!-- ---------- 6. Hoy: piezas de vidrio sobre el Humilladero ---------- -->
  <section class="hoy" id="hoy" aria-labelledby="titulo-hoy">
    <Picture src={puente.src} formats={['avif', 'webp']} widths={[640, 1200]} sizes="100vw" alt="" class="hoy__fondo" />
    <div class="hoy__velo" aria-hidden="true"></div>
    <h2 id="titulo-hoy" class="hoy__titulo">Hoy en Popayán</h2>

    <div class="mosaico">
      <div class="pieza pieza--agenda vidrio" data-pieza>
        <h3 class="pieza__titulo">Agenda</h3>
        <ol class="agenda">
          {
            eventos.map((e, i) => (
              <li data-evento data-inicio={e.data.inicio} data-fin={e.data.fin ?? e.data.inicio} hidden={i >= 4}>
                <a href="/agenda">
                  <span class="agenda__dia">{diaDelMes(e.data.inicio)}</span>
                  <span class="agenda__mes">{nombreDelMes(e.data.inicio)}</span>
                  <span class="agenda__nombre">
                    {e.data.nombre}
                    <span class="agenda__ahora" hidden>
                      Ahora
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
        <a class="enlace" href="/agenda">Toda la agenda <Icono nombre="arrow-right" /></a>
      </div>

      <figure class="pieza pieza--dato vidrio" data-pieza data-datos={JSON.stringify(datos)}>
        <h3 class="pieza__titulo">¿Sabías que…?</h3>
        <blockquote>
          <p class="dato__texto">{datos[0].dato}</p>
        </blockquote>
        <figcaption>
          <a href={`/lugares/${datos[0].id}`} data-dato-enlace>{datos[0].nombre}</a>
        </figcaption>
      </figure>

      <div class="pieza pieza--cocina" data-pieza>
        <h3 class="pieza__titulo">La cocina de Popayán</h3>
        <ul class="carta" aria-label="Recetas">
          {
            recetas.map((r) => (
              <li>
                <a href={`/recetario/${r.id}`}>{r.data.nombre}</a>
              </li>
            ))
          }
        </ul>
        <a class="enlace" href="/recetario">El recetario vivo <Icono nombre="arrow-right" /></a>
      </div>
    </div>
    <a class="credito credito--hoy" href={puente.credito.fuente} rel="noopener noreferrer">Foto: {lineaCredito(puente.credito)}</a>
  </section>

  <!-- ---------- 7. Historia: el año corre de 1537 a hoy mientras se baja ---------- -->
  <section class="escena historia" aria-labelledby="titulo-historia" data-escena="historia">
    <div class="escenario historia__escenario">
      <h2 id="titulo-historia" class="historia__titulo">Cinco siglos de <em>historia</em></h2>
      <div class="contador" aria-hidden="true" data-contador data-hitos={JSON.stringify(hitos.map((h) => ({ anio: h.data.anio, titulo: h.data.titulo })))}>
        <span class="contador__anio" data-contador-anio>{hitos[0].data.anio}</span>
        <span class="contador__titulo" data-contador-titulo>{hitos[0].data.titulo}</span>
        <span class="contador__linea"><span data-contador-avance></span></span>
      </div>
      <ol class="anios" aria-label="Momentos de la historia de Popayán">
        {
          hitos.map((h) => (
            <li>
              <span class="anios__anio">{h.data.anio}</span>
              <span class="anios__titulo">{h.data.titulo}</span>
            </li>
          ))
        }
      </ol>
      <div class="historia__enlaces">
        <a class="enlace" href="/historia">La línea de tiempo <Icono nombre="arrow-right" /></a>
        <a class="enlace" href="/personajes">Los personajes de esta historia <Icono nombre="arrow-right" /></a>
      </div>
    </div>
  </section>

  <!-- ---------- 8. Cierre ---------- -->
  <section class="cierre" aria-labelledby="titulo-cierre">
    <span class="cierre__torre isotipo" aria-hidden="true"></span>
    <h2 id="titulo-cierre">Empieza por <em>una ruta.</em></h2>
    <div class="acciones">
      <a class="boton boton--lleno" href="/rutas">Ver las rutas</a>
      <a class="boton boton--tinte" href="/mapa">
        <Icono nombre="map-trifold" />
        Abrir el mapa
      </a>
    </div>
  </section>
</Base>

<script>
  import { animate, inView, scroll } from 'motion';
  import { momento } from '../lib/semana-santa';
  import { sellosGuardados } from '../lib/sello-cliente';

  const raiz = document.documentElement;
  const conMovimiento = !matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (conMovimiento) raiz.classList.add('inmersivo');

  // Cuánto de un tramo [a, b] del avance se ha recorrido, entre 0 y 1
  const tramo = (p: number, a: number, b: number) => Math.min(1, Math.max(0, (p - a) / (b - a)));
  const suave = (t: number) => 1 - Math.pow(1 - t, 3);
  const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel);
  // El avance de una escena: 0 cuando su escenario se fija arriba, 1 cuando se suelta
  const escena = (nombre: string, fn: (p: number) => void, offset = ['start start', 'end end']) => {
    const el = $(`[data-escena="${nombre}"]`);
    if (el) scroll((p: number) => fn(p), { target: el, offset });
  };

  // ---------- La hora de Popayán ----------
  const NUMEROS = ['doce', 'una', 'dos', 'tres', 'cuatro', 'cinco', 'seis', 'siete', 'ocho', 'nueve', 'diez', 'once'];
  const partes = new Intl.DateTimeFormat('es-CO', {
    timeZone: 'America/Bogota',
    hour: 'numeric',
    minute: 'numeric',
    hourCycle: 'h23',
  }).formatToParts(new Date());
  const hora = Number(partes.find((p) => p.type === 'hour')?.value ?? 0);
  const minuto = Number(partes.find((p) => p.type === 'minute')?.value ?? 0);
  const h12 = hora % 12;
  const art = (n: number) => (n === 1 ? 'la' : 'las');
  const hTexto = $('[data-hora]');
  if (hTexto)
    hTexto.textContent =
      minuto < 10
        ? `En Popayán son ${art(h12)} ${NUMEROS[h12]}`
        : minuto < 40
          ? `En Popayán ya pasaron ${art(h12)} ${NUMEROS[h12]}`
          : `En Popayán son casi ${art((h12 + 1) % 12)} ${NUMEROS[(h12 + 1) % 12]}`;
  const anguloHora = (h12 + minuto / 60) * 30;
  const manecilla = $<SVGGElement>('[data-manecilla]');
  const girar = (grados: number) => manecilla?.setAttribute('transform', `rotate(${grados} 60 60)`);
  girar(anguloHora);

  // ---------- Agenda: lo que pasa ahora y lo que viene ----------
  const hoy = new Date();
  const hoyUTC = Date.UTC(hoy.getFullYear(), hoy.getMonth(), hoy.getDate());
  const aFecha = (iso: string) => Date.parse(`${iso}T00:00:00Z`);
  let mostrados = 0;
  for (const li of document.querySelectorAll<HTMLElement>('[data-evento]')) {
    const vigente = aFecha(li.dataset.fin!) >= hoyUTC && mostrados < 4;
    li.hidden = !vigente;
    if (vigente) {
      mostrados++;
      if (aFecha(li.dataset.inicio!) <= hoyUTC) li.querySelector<HTMLElement>('.agenda__ahora')!.hidden = false;
    }
  }

  // ---------- Semana Santa, contada desde el día de hoy del visitante ----------
  const cuenta = $('[data-semana-santa]');
  if (cuenta) {
    const hoyIso = `${hoy.getFullYear()}-${String(hoy.getMonth() + 1).padStart(2, '0')}-${String(hoy.getDate()).padStart(2, '0')}`;
    const ahora = momento(hoyIso);
    const parte = (clase: string, texto: string) => Object.assign(document.createElement('span'), { className: clase, textContent: texto });
    if (ahora.tipo === 'antes') {
      const cifra = parte('semana__cifra', String(ahora.dias));
      cifra.dataset.cifra = '';
      cuenta.replaceChildren(cifra, parte('semana__texto', ahora.dias === 1 ? 'día para el Domingo de Ramos' : 'días para el Domingo de Ramos'));
      cuenta.dataset.dias = String(ahora.dias);
    } else {
      cuenta.replaceChildren(parte('semana__texto', 'Es Semana Santa: mira la procesión de hoy'));
      cuenta.dataset.dias = '';
    }
  }

  // ---------- Cuántos sellos lleva el visitante (se guardan en su teléfono) ----------
  const pasaporte = $('[data-pasaporte-texto]');
  const sellos = Object.keys(sellosGuardados()).length;
  if (pasaporte && sellos > 0) pasaporte.textContent = `Llevas ${sellos} de ${pasaporte.dataset.total} sellos`;

  // ---------- Un dato distinto en cada visita ----------
  const caja = $('[data-datos]');
  if (caja) {
    const lista: { id: string; nombre: string; dato: string }[] = JSON.parse(caja.dataset.datos ?? '[]');
    const elegido = lista[Math.floor(Math.random() * lista.length)];
    if (elegido) {
      caja.querySelector('.dato__texto')!.textContent = elegido.dato;
      const enlace = caja.querySelector<HTMLAnchorElement>('[data-dato-enlace]')!;
      enlace.textContent = elegido.nombre;
      enlace.href = `/lugares/${elegido.id}`;
    }
  }

  if (conMovimiento) {
    // ---------- 1. Apertura: la foto se recoge en un marco y el texto se va hacia arriba ----------
    const marco = $('[data-marco]');
    const texto = $('[data-apertura-texto]');
    escena('apertura', (p) => {
      const t = suave(tramo(p, 0, 1));
      if (marco) {
        marco.style.transform = `scale(${1 - 0.1 * t})`;
        marco.style.borderRadius = `${36 * t}px`;
      }
      if (texto) {
        texto.style.opacity = String(1 - tramo(p, 0, 0.55));
        texto.style.transform = `translateY(${-70 * t}px)`;
      }
    });

    // ---------- 2. La torre: la manecilla da una vuelta entera y se detiene en la hora de ahora ----------
    const frases = [...document.querySelectorAll<HTMLElement>('[data-frase]')];
    const fotoTorre = $('[data-torre-foto]');
    const horaTorre = $('[data-torre-hora]');
    escena('torre', (p) => {
      girar(suave(tramo(p, 0.02, 0.9)) * (360 + anguloHora));
      if (fotoTorre) fotoTorre.style.transform = `scale(${1.12 - 0.12 * p})`;
      const n = frases.length;
      frases.forEach((f, i) => {
        const entra = tramo(p, (i / n) * 0.9, (i / n) * 0.9 + 0.08);
        const sale = i === n - 1 ? 0 : tramo(p, ((i + 1) / n) * 0.9 - 0.06, ((i + 1) / n) * 0.9);
        f.style.opacity = String(entra * (1 - sale));
        f.style.transform = `translateY(${(1 - entra) * 28 - sale * 28}px)`;
      });
      if (horaTorre) {
        const t = tramo(p, 0.86, 0.96);
        horaTorre.style.opacity = String(t);
        horaTorre.style.transform = `translateY(${(1 - t) * 16}px)`;
      }
    });

    // ---------- 3. Rutas: en escritorio, la pista corre de lado ----------
    const seccionRutas = $('[data-escena="rutas"]');
    const pista = $('[data-pista]');
    const ancha = matchMedia('(min-width: 48rem)');
    let sobra = 0;
    const medir = () => {
      if (!seccionRutas || !pista) return;
      if (!ancha.matches) {
        sobra = 0;
        seccionRutas.style.height = '';
        pista.style.transform = '';
        return;
      }
      sobra = Math.max(0, pista.scrollWidth - pista.clientWidth);
      seccionRutas.style.height = `${innerHeight + sobra}px`;
    };
    medir();
    addEventListener('resize', medir);
    ancha.addEventListener('change', medir);
    escena('rutas', (p) => {
      if (pista && sobra) pista.style.transform = `translateX(${-p * sobra}px)`;
    });
    // Quien navega con el teclado lleva la página hasta la tarjeta que recibe el foco
    pista?.addEventListener('focusin', (e) => {
      if (!sobra || !seccionRutas) return;
      const item = (e.target as HTMLElement).closest('li')!;
      const p = Math.min(1, item.offsetLeft / (sobra + pista.clientWidth / 2));
      scrollTo({ top: seccionRutas.offsetTop + p * sobra, behavior: 'instant' });
    });

    // ---------- El Pasaporte: la tapa se abre y cada sello cae en su turno, con el golpe de un sello de goma ----------
    const tapa = $('[data-pp-tapa]');
    const textoPasaporte = $('[data-pp-texto]');
    const sellosEscena = [...document.querySelectorAll<HTMLElement>('[data-pp-sello]')];
    const caidos = new Set<number>();
    escena('pasaporte', (p) => {
      if (tapa) {
        const t = suave(tramo(p, 0.04, 0.3));
        tapa.style.transform = `rotateY(${-172 * t}deg)`;
        tapa.style.opacity = String(t > 0.92 ? 0 : 1);
      }
      if (textoPasaporte) {
        const t = tramo(p, 0.25, 0.4);
        textoPasaporte.style.opacity = String(t);
        textoPasaporte.style.transform = `translateY(${(1 - t) * 24}px)`;
      }
      sellosEscena.forEach((sello, i) => {
        const umbral = 0.32 + i * 0.09;
        if (p >= umbral && !caidos.has(i)) {
          caidos.add(i);
          animate(sello, { opacity: [0, 1], scale: [1.8, 1], rotate: [-16, 0] }, { type: 'spring', bounce: 0.38, duration: 0.55 });
          setTimeout(() => navigator.vibrate?.(14), 160);
        } else if (p < umbral - 0.03 && caidos.has(i)) {
          // Al volver hacia arriba, el sello se levanta del papel
          caidos.delete(i);
          animate(sello, { opacity: 0, scale: 1.4 }, { duration: 0.2 });
        }
      });
    });

    // ---------- 4. El Morro: la foto se acerca a la cima ----------
    const fotoMorro = $('[data-morro-foto]');
    const fraseA = $('[data-morro-a]');
    const fraseB = $('[data-morro-b]');
    const notaMorro = $('[data-morro-nota]');
    escena('morro', (p) => {
      if (fotoMorro) fotoMorro.style.transform = `scale(${1 + 0.55 * suave(tramo(p, 0.15, 0.85))})`;
      if (fraseA) {
        const sale = tramo(p, 0.3, 0.42);
        fraseA.style.opacity = String(1 - sale);
        fraseA.style.transform = `translateY(${-sale * 30}px)`;
      }
      if (fraseB) {
        const entra = tramo(p, 0.45, 0.6);
        fraseB.style.opacity = String(entra);
        fraseB.style.transform = `scale(${0.92 + 0.08 * entra})`;
      }
      if (notaMorro) {
        const entra = tramo(p, 0.7, 0.85);
        notaMorro.style.opacity = String(entra);
        notaMorro.style.transform = `translateY(${(1 - entra) * 24}px)`;
      }
    });

    // ---------- 5. Semana Santa: la cuenta corre hasta los días que faltan, desde que la escena asoma ----------
    escena(
      'semana',
      (p) => {
        const cifra = $('[data-cifra]');
        const dias = Number(cuenta?.dataset.dias);
        if (cifra && dias) cifra.textContent = String(Math.round(dias * suave(tramo(p, 0.2, 0.62))));
      },
      ['start end', 'end end'],
    );

    // ---------- 6. Hoy: las piezas llegan al verlas y los sellos caen como puestos a mano ----------
    for (const pieza of document.querySelectorAll<HTMLElement>('[data-pieza]')) {
      inView(
        pieza,
        () => {
          animate(pieza, { opacity: [0, 1], y: [32, 0], scale: [0.97, 1] }, { type: 'spring', bounce: 0, duration: 0.8 });
        },
        { amount: 0.25 },
      );
    }

    // ---------- 7. Historia: el año corre entre los hitos ----------
    const contador = $('[data-contador]');
    if (contador) {
      const lista: { anio: number; titulo: string }[] = JSON.parse(contador.dataset.hitos ?? '[]');
      const anio = $('[data-contador-anio]')!;
      const titulo = $('[data-contador-titulo]')!;
      const avance = $('[data-contador-avance]')!;
      let ultimo = -1;
      escena('historia', (p) => {
        const f = tramo(p, 0.05, 0.92) * (lista.length - 1);
        const i = Math.min(lista.length - 2, Math.floor(f));
        const t = f - i;
        anio.textContent = String(Math.round(lista[i].anio + (lista[i + 1].anio - lista[i].anio) * t));
        const cerca = Math.round(f);
        if (cerca !== ultimo) {
          ultimo = cerca;
          titulo.textContent = lista[cerca].titulo;
          animate(titulo, { opacity: [0, 1], y: [10, 0] }, { duration: 0.35 });
        }
        avance.style.transform = `scaleX(${tramo(p, 0.05, 0.92)})`;
      });
    }
  }
</script>

