---
import { getCollection, getEntries, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Encabezado from '../components/vidrio/Encabezado.astro';
import Icono from '../components/Icono.astro';
import { diaDeLaSemana, diaDelMes, mesYAnio, nombreDelMes } from '../lib/fechas';

// Lo que ya terminó el día de la compilación no se publica; lo que termine después lo retira
// public/js/agenda-hoy.js en el navegador. Así la lista casi nunca cambia después de pintarse.
const hoyEnPopayan = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Bogota' }).format(new Date());
const eventos = (await getCollection('eventos'))
  .filter((e) => (e.data.fin ?? e.data.inicio) >= hoyEnPopayan)
  .sort((a, b) => a.data.inicio.localeCompare(b.data.inicio));

// Lugares y rutas que nombra cada evento, resueltos una sola vez
const conEnlaces = await Promise.all(
  eventos.map(async (evento) => {
    const { lugar, ruta, jornadas } = evento.data;
    const lugaresJornadas = jornadas
      ? await getEntries(jornadas.flatMap((j) => (j.lugar ? [j.lugar] : [])))
      : [];
    const porId = new Map(lugaresJornadas.map((l) => [l.id, l]));
    return {
      evento,
      lugar: lugar ? await getEntry(lugar) : undefined,
      ruta: ruta ? await getEntry(ruta) : undefined,
      jornadas: jornadas?.map((j) => ({ ...j, sitio: j.lugar ? porId.get(j.lugar.id) : undefined })),
    };
  }),
);

// Agrupados por mes de inicio, en orden
const meses = new Map<string, typeof conEnlaces>();
for (const item of conEnlaces) {
  const clave = item.evento.data.inicio.slice(0, 7);
  meses.set(clave, [...(meses.get(clave) ?? []), item]);
}
const mesCorto = (iso: string) => nombreDelMes(iso).slice(0, 3);
---

<Base
  titulo="Agenda"
  seccion="agenda"
  descripcion="Lo que pasa en Popayán a lo largo del año: Congreso Gastronómico, Navidad, Fiestas de Pubenza, Semana Santa y más."
>
  <Encabezado
    ancho="medio"
    titulo="Agenda"
    bajada="El año de Popayán, del Congreso Gastronómico a la Semana Santa. Cuando los organizadores todavía no anuncian las fechas, lo decimos."
  />

  <div class="pagina">
    <p class="proximo" data-proximo></p>

    {
      [...meses].map(([clave, items]) => (
        <section class="mes" aria-labelledby={`mes-${clave}`} data-mes>
          <h2 class="mes__titulo" id={`mes-${clave}`}>
            {mesYAnio(`${clave}-01`)}
          </h2>
          <div class="mes__eventos">
            {items.map(({ evento, lugar, ruta, jornadas }) => {
              const { nombre, enFrase, cuando, inicio, fin, confirmada, resumen, fuentes } = evento.data;
              const datos = {
                'data-evento': '',
                'data-inicio': inicio,
                'data-fin': fin ?? inicio,
                'data-frase': enFrase,
                'data-confirmada': String(confirmada),
              };
              return (
                <article
                  class:list={['evento', { 'evento--noche': jornadas }]}
                  aria-labelledby={`evento-${evento.id}`}
                  {...datos}
                >
                  <div class="evento__cabeza">
                    <p class="hoja-calendario" aria-hidden="true">
                      <span>{mesCorto(inicio)}</span>
                      <strong>{diaDelMes(inicio)}</strong>
                    </p>
                    <div class="evento__titulos">
                      <h3 id={`evento-${evento.id}`}>{nombre}</h3>
                      <p class="evento__cuando">
                        {!confirmada && <Icono nombre="seal-question" etiqueta="Fecha sin confirmar" />}
                        {cuando}
                      </p>
                    </div>
                  </div>

                  <p class="evento__resumen">{resumen}</p>

                  {jornadas && (
                    <ol class="noches">
                      {jornadas.map((j) => (
                        <li class="noche">
                          <span class="noche__dia">
                            <strong>{diaDelMes(j.fecha)}</strong>
                            <span>{diaDeLaSemana(j.fecha)}</span>
                          </span>
                          <span class="noche__texto">
                            <span class="noche__nombre">{j.nombre}</span>
                            {(j.sitio || j.hora) && (
                              <span class="noche__pie">
                                {j.sitio && <a href={`/lugares/${j.sitio.id}`}>{j.sitio.data.nombre}</a>}
                                {j.sitio && j.hora && ' · '}
                                {j.hora && <span>Hacia las {j.hora}</span>}
                              </span>
                            )}
                          </span>
                        </li>
                      ))}
                    </ol>
                  )}

                  {(lugar || ruta || jornadas) && (
                    <ul class="evento__enlaces">
                      {jornadas && (
                        <li>
                          <a class="ficha" href="/semana-santa">
                            <Icono nombre="calendar-dots" peso="fill" />
                            Las procesiones noche por noche
                          </a>
                        </li>
                      )}
                      {lugar && (
                        <li>
                          <a class="ficha" href={`/lugares/${lugar.id}`}>
                            <Icono nombre="map-pin" peso="fill" />
                            {lugar.data.nombre}
                          </a>
                        </li>
                      )}
                      {ruta && (
                        <li>
                          <a class="ficha" href={`/rutas/${ruta.id}`}>
                            <Icono nombre={ruta.data.modo === 'carro' ? 'car-simple' : 'footprints'} peso="fill" />
                            {ruta.data.nombre}
                          </a>
                        </li>
                      )}
                    </ul>
                  )}

                  <p class="evento__fuentes">
                    Fuentes:{' '}
                    {fuentes.map((f, i) => (
                      <>
                        {i > 0 && ' · '}
                        <a href={f.url} rel="noopener noreferrer">
                          {f.titulo}
                        </a>
                      </>
                    ))}
                  </p>
                </article>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>

  <!-- Sin defer a propósito: ajusta la lista al día de hoy antes de que se pinte -->
  <script is:inline src="/js/agenda-hoy.js"></script>
</Base>


<style>
  .pagina {
    display: grid;
    gap: 2.5rem;
    max-width: 46rem;
    margin-inline: auto;
    padding: 0.25rem var(--margen) 0;
  }

  /* La cuenta regresiva: una sola frase grande, con la cifra en terracota */
  .proximo {
    padding: 22px 22px 24px;
    border-radius: var(--radio-l);
    background: var(--fondo-elevado);
    font-family: var(--fuente-titulos);
    font-size: clamp(1.5rem, 1.25rem + 1.1vw, 2.125rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.028em;
    /* El espacio de dos líneas queda reservado desde el inicio: la frase llega sin empujar la lista */
    min-height: calc(2 * 1.12em + 46px);
  }

  .proximo:empty {
    visibility: hidden;
  }

  .proximo[hidden] {
    display: none;
  }

  .proximo :global(strong) {
    color: var(--acento);
    font-variant-numeric: tabular-nums;
  }

  .mes {
    display: grid;
    gap: 12px;
  }

  .mes[hidden] {
    display: none;
  }

  .mes__titulo {
    padding-inline: 4px;
    font-size: var(--t-titulo);
    letter-spacing: -0.022em;
  }

  .mes__eventos {
    display: grid;
    gap: 12px;
  }

  /* ---------- Un evento: tarjeta sólida con la hoja de calendario ---------- */
  .evento {
    display: grid;
    gap: 14px;
    padding: 18px 18px 16px;
    border-radius: var(--radio-l);
    background: var(--fondo-elevado);
  }

  .evento[hidden] {
    display: none;
  }

  .evento__cabeza {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    align-items: center;
  }

  .hoja-calendario {
    display: grid;
    justify-items: center;
    width: 56px;
    padding: 6px 0 7px;
    border-radius: 14px;
    background: var(--fondo);
    line-height: 1;
  }

  .hoja-calendario span {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--acento);
  }

  .hoja-calendario strong {
    margin-top: 3px;
    font-family: var(--fuente-titulos);
    font-size: 1.625rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .evento__titulos {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .evento h3 {
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .evento__cuando {
    display: flex;
    gap: 6px;
    align-items: flex-start;
    font-size: var(--t-nota);
    font-weight: 600;
    color: var(--texto-2);
  }

  .evento__cuando :global(svg) {
    flex: none;
    margin-top: 0.2em;
    color: var(--acento);
  }

  .evento__resumen {
    line-height: 1.5;
  }

  .evento__enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    list-style: none;
  }

  .ficha {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 14px 0 11px;
    border-radius: var(--radio-capsula);
    background: color-mix(in srgb, var(--acento) 12%, transparent);
    color: var(--acento);
    font-size: var(--t-nota);
    font-weight: 600;
    text-decoration: none;
  }

  .evento__fuentes {
    font-size: var(--t-mini);
    color: var(--texto-2);
  }

  .evento__fuentes a {
    color: inherit;
  }

  /* ---------- Semana Santa: la tarjeta vive de noche, sea cual sea el tema ---------- */
  .evento--noche {
    --fondo-elevado: #1b1622;
    --fondo: #2a2233;
    --texto: #f5f2f7;
    --texto-2: rgb(245 242 247 / 0.68);
    --acento: #ff8a5c;
    color: var(--texto);
    background:
      radial-gradient(120% 70% at 100% 0%, rgb(255 138 92 / 0.16), transparent 60%),
      var(--fondo-elevado);
  }

  .noches {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .noche {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 12px;
    padding-block: 12px;
  }

  .noche + .noche {
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }

  .noche__dia {
    display: grid;
    align-content: start;
    line-height: 1.1;
  }

  .noche__dia strong {
    font-family: var(--fuente-titulos);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--acento);
    font-variant-numeric: tabular-nums;
  }

  .noche__dia span {
    font-size: var(--t-mini);
    color: var(--texto-2);
  }

  .noche__texto {
    display: grid;
    gap: 3px;
  }

  .noche__nombre {
    line-height: 1.4;
  }

  .noche__pie {
    font-size: var(--t-mini);
    color: var(--texto-2);
  }

  .noche__pie a {
    color: var(--texto);
  }
</style>
