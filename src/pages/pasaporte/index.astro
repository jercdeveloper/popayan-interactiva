---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import Compartir from '../../components/Compartir.astro';
import Sello from '../../components/pasaporte/Sello.astro';
import { CATEGORIAS } from '../../lib/lugares';

const lugares = (await getCollection('lugares')).sort((a, b) => a.data.nombre.localeCompare(b.data.nombre, 'es'));
const porId = new Map(lugares.map((l) => [l.id, l]));
const rutas = (await getCollection('rutas')).sort((a, b) => a.data.orden - b.data.orden);

// Una colección por ruta, en el orden de la ruta; lo que no está en ninguna va al final
const enRutas = new Set(rutas.flatMap((r) => r.data.paradas.map((p) => p.id)));
const colecciones = [
  ...rutas.map((r) => ({
    id: r.id,
    nombre: r.data.nombre,
    ruta: true,
    lugares: r.data.paradas.map((p) => porId.get(p.id)!),
  })),
  { id: 'mas-lugares', nombre: 'Más lugares', ruta: false, lugares: lugares.filter((l) => !enRutas.has(l.id)) },
].filter((c) => c.lugares.length > 0);
---

<Base
  titulo="Pasaporte"
  seccion="pasaporte"
  descripcion="El Pasaporte de Popayán: sella cada lugar cuando estés en él y completa las colecciones de las rutas. Sin cuentas: tus sellos viven en tu teléfono."
>
  <!-- La tapa: cuero teja con el escudo de la torre en oro. Al bajar, se levanta como la de un pasaporte de verdad -->
  <header class="mesa">
    <div class="tapa">
      <span class="tapa__escudo isotipo" aria-hidden="true"></span>
      <h1 class="tapa__titulo">Pasaporte <em>de Popayán</em></h1>
      <p class="tapa__lema">{lugares.length} lugares · un sello por cada uno</p>
    </div>
  </header>

  <div class="pagina" data-pasaporte data-ids={JSON.stringify(lugares.map((l) => l.id))}>
    <!-- La primera hoja: tu avance -->
    <section class="hoja-pasaporte resumen" aria-label="Tu avance">
      <p class="resumen__cifra">
        <strong data-cuenta>0</strong>
        <span>de {lugares.length} sellos</span>
      </p>
      <div class="resumen__barra" aria-hidden="true"><span data-barra></span></div>
      <p class="resumen__texto" data-resumen-texto>
        Todavía no tienes sellos. Empieza por la <a href="/rutas/templos">Ruta de los templos</a>.
      </p>
      <p class="resumen__como">
        Cada sello se gana estando allí: con la ubicación del teléfono o con el código QR del lugar.
      </p>
    </section>

    {
      colecciones.map((c, i) => (
        <section class="hoja-pasaporte coleccion revelar" aria-labelledby={`coleccion-${c.id}`} data-coleccion={c.id} data-folio={i + 2}>
          <header class="coleccion__cabeza">
            <h2 id={`coleccion-${c.id}`}>
              {c.ruta ? <a href={`/rutas/${c.id}`}>{c.nombre}</a> : c.nombre}
            </h2>
            <span class="coleccion__cuenta">
              <span data-coleccion-cuenta>0</span> de {c.lugares.length}
            </span>
            <span class="coleccion__completa" data-coleccion-completa hidden>
              <Icono nombre="seal-check" peso="fill" />
              Completa
            </span>
            {c.ruta && (
              <span class="coleccion__compartir" data-coleccion-compartir hidden>
                <Compartir
                  enlace={`/rutas/${c.id}`}
                  tarjeta={`/tarjetas/rutas/${c.id}.jpg`}
                  titulo={c.nombre}
                  texto={`Completé la ${c.nombre} en el Pasaporte de Popayán.`}
                />
              </span>
            )}
          </header>
          <ol class="sellos">
            {c.lugares.map((l) => (
              <li>
                <a class="hueco" href={`/lugares/${l.id}`} data-hueco={l.id}>
                  <Sello
                    id={l.id}
                    clave={`${c.id}-${l.id}`}
                    tipo={CATEGORIAS[l.data.categoria].singular}
                    icono={CATEGORIAS[l.data.categoria].icono}
                  />
                  <span class="hueco__nombre">{l.data.nombre}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    <section class="grupo" aria-labelledby="titulo-como">
      <h2 class="grupo__titulo" id="titulo-como">Cómo se gana un sello</h2>
      <ul class="celdas">
        <li>
          <span class="celda">
            <Icono nombre="map-pin" class="celda__icono" />
            <span class="celda__texto">
              Estando en el lugar
              <small>En la ficha de cada lugar está el botón «Sellar mi pasaporte». Funciona a unos 40 m del lugar; en plazas, puentes y haciendas, un poco más lejos.</small>
            </span>
          </span>
        </li>
        <li>
          <span class="celda">
            <Icono nombre="qr-code" class="celda__icono" />
            <span class="celda__texto">
              Con el código QR del lugar
              <small>Donde el GPS falla, como dentro de un templo, el código QR del Pasaporte también sella.</small>
            </span>
          </span>
        </li>
        <li>
          <span class="celda">
            <Icono nombre="lock-simple" class="celda__icono" />
            <span class="celda__texto">
              Tus sellos son tuyos
              <small>No hay cuentas. Los sellos se guardan solo en este teléfono, con el lugar y el día. Tu ubicación no se guarda.</small>
            </span>
          </span>
        </li>
      </ul>
    </section>

    <section class="grupo" aria-labelledby="titulo-copia">
      <h2 class="grupo__titulo" id="titulo-copia">Copia de seguridad</h2>
      <div class="copia">
        <p>
          Si borras los datos del navegador o cambias de teléfono, los sellos se pierden. Guarda una copia: es un código
          que puedes enviarte a ti mismo.
        </p>
        <div class="copia__acciones">
          <button type="button" class="boton boton--lleno" data-copiar>
            <Icono nombre="copy" />
            Copiar el código
          </button>
          <button type="button" class="boton boton--tinte" data-descargar>
            <Icono nombre="download-simple" />
            Descargar un archivo
          </button>
        </div>
        <label class="copia__etiqueta" for="codigo">Recuperar los sellos de una copia</label>
        <textarea id="codigo" rows="3" placeholder="Pega aquí el código, que empieza por PI1." data-codigo></textarea>
        <div class="copia__acciones">
          <button type="button" class="boton boton--tinte" data-recuperar>Recuperar</button>
          <label class="boton boton--tinte copia__archivo">
            Abrir un archivo
            <input type="file" accept=".txt,text/plain" data-archivo />
          </label>
        </div>
        <p class="copia__aviso" role="status" aria-live="polite" data-copia-aviso></p>
      </div>
    </section>
  </div>
</Base>

<script>
  import { exportar, guardar, importar, unir, type Sellos } from '../../lib/pasaporte';
  import { mostrarGanado, sellosGuardados } from '../../lib/sello-cliente';

  const raiz = document.querySelector<HTMLElement>('[data-pasaporte]')!;
  const validos = new Set<string>(JSON.parse(raiz.dataset.ids ?? '[]'));
  const aviso = document.querySelector<HTMLElement>('[data-copia-aviso]')!;

  function pintar(sellos: Sellos) {
    const ganados = Object.keys(sellos).filter((id) => validos.has(id));
    document.querySelector('[data-cuenta]')!.textContent = String(ganados.length);
    document.querySelector<HTMLElement>('[data-barra]')!.style.transform = `scaleX(${ganados.length / validos.size})`;
    const texto = document.querySelector<HTMLElement>('[data-resumen-texto]')!;
    if (ganados.length === validos.size) texto.textContent = '¡Completaste el Pasaporte de Popayán!';
    else if (ganados.length > 0) texto.textContent = `Te faltan ${validos.size - ganados.length} lugares.`;

    for (const hueco of document.querySelectorAll<HTMLElement>('[data-hueco]')) {
      const sello = sellos[hueco.dataset.hueco!];
      if (sello) mostrarGanado(hueco, sello);
    }
    for (const c of document.querySelectorAll<HTMLElement>('[data-coleccion]')) {
      const huecos = [...c.querySelectorAll<HTMLElement>('[data-hueco]')];
      const listos = huecos.filter((h) => sellos[h.dataset.hueco!]).length;
      c.querySelector('[data-coleccion-cuenta]')!.textContent = String(listos);
      const completa = listos === huecos.length;
      c.classList.toggle('coleccion--completa', completa);
      c.querySelector<HTMLElement>('[data-coleccion-completa]')!.hidden = !completa;
      const compartir = c.querySelector<HTMLElement>('[data-coleccion-compartir]');
      if (compartir) compartir.hidden = !completa;
    }
  }

  pintar(sellosGuardados());
  // Pedirle al navegador que no borre los sellos cuando le falte espacio
  navigator.storage?.persist?.().catch(() => {});

  const decir = (mensaje: string) => (aviso.textContent = mensaje);

  document.querySelector('[data-copiar]')!.addEventListener('click', async () => {
    const sellos = sellosGuardados();
    if (!Object.keys(sellos).length) return decir('Todavía no hay sellos que copiar.');
    try {
      await navigator.clipboard.writeText(exportar(sellos));
      decir('Código copiado. Guárdalo en tus notas o envíatelo por WhatsApp.');
    } catch {
      decir('No se pudo copiar. Usa «Descargar un archivo».');
    }
  });

  document.querySelector('[data-descargar]')!.addEventListener('click', () => {
    const sellos = sellosGuardados();
    if (!Object.keys(sellos).length) return decir('Todavía no hay sellos que guardar.');
    const enlace = document.createElement('a');
    enlace.href = URL.createObjectURL(new Blob([exportar(sellos)], { type: 'text/plain' }));
    enlace.download = 'pasaporte-popayan.txt';
    enlace.click();
    setTimeout(() => URL.revokeObjectURL(enlace.href), 1000);
    decir('Archivo descargado.');
  });

  function recuperar(codigo: string) {
    const copia = importar(codigo, validos);
    if (!copia) return decir('Ese código no es una copia del Pasaporte. Revisa que esté completo.');
    const antes = sellosGuardados();
    const juntos = unir(antes, copia);
    const nuevos = Object.keys(juntos).length - Object.keys(antes).length;
    if (!guardar(localStorage, juntos)) return decir('Este navegador no deja guardar los sellos.');
    pintar(juntos);
    decir(nuevos > 0 ? `Listo: recuperaste ${nuevos} ${nuevos === 1 ? 'sello' : 'sellos'}.` : 'Ya tenías todos esos sellos.');
  }

  document.querySelector('[data-recuperar]')!.addEventListener('click', () => {
    recuperar(document.querySelector<HTMLTextAreaElement>('[data-codigo]')!.value);
  });

  document.querySelector<HTMLInputElement>('[data-archivo]')!.addEventListener('change', async (e) => {
    const archivo = (e.target as HTMLInputElement).files?.[0];
    if (archivo) recuperar(await archivo.text());
  });
</script>

<style>
  /* ---------- La mesa y la tapa ---------- */
  .mesa {
    position: relative;
    display: grid;
    place-items: center;
    padding: calc(4.5rem + env(safe-area-inset-top)) var(--margen) 4.5rem;
    background:
      radial-gradient(60% 50% at 50% 45%, rgb(255 170 110 / 0.16), transparent 70%),
      var(--noche);
    perspective: 1600px;
    overflow: hidden;
  }

  /* El borde de la hoja, como en las cabeceras con foto */
  .mesa::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 26px;
    border-radius: 26px 26px 0 0;
    background: var(--fondo);
  }

  .tapa {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 1.1rem;
    width: min(80vw, 22rem);
    aspect-ratio: 5 / 7;
    padding: 2rem 1.5rem;
    border-radius: 10px 18px 18px 10px;
    /* Cuero: el teja hondo, con una luz de lado y un grano muy fino */
    background:
      radial-gradient(120% 80% at 20% 0%, rgb(255 255 255 / 0.12), transparent 55%),
      repeating-linear-gradient(115deg, rgb(0 0 0 / 0.035) 0 2px, transparent 2px 5px),
      var(--teja-hondo);
    color: var(--maiz);
    text-align: center;
    box-shadow:
      inset 6px 0 10px -4px rgb(0 0 0 / 0.45),
      0 40px 70px -30px rgb(0 0 0 / 0.8),
      0 4px 10px rgb(0 0 0 / 0.3);
    transform-origin: 50% 0;
  }

  /* El filete dorado, a unos milímetros del borde */
  .tapa::before {
    content: '';
    position: absolute;
    inset: 12px;
    border: 1.5px solid rgb(232 181 58 / 0.55);
    border-radius: 6px 12px 12px 6px;
    pointer-events: none;
  }

  .tapa__escudo {
    width: 4.5rem;
    height: 5.2rem;
    background: linear-gradient(160deg, #fbe39a, #e8b53a 45%, #b9832a);
    filter: drop-shadow(0 1px 0 rgb(0 0 0 / 0.35));
  }

  .tapa__titulo {
    font-size: clamp(2.1rem, 1.6rem + 2.2vw, 2.8rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: 0.01em;
    color: #f3cf74;
    text-shadow: 0 1px 0 rgb(0 0 0 / 0.35);
  }

  .tapa__titulo em {
    display: block;
    font-size: 0.72em;
  }

  .tapa__lema {
    font-size: var(--t-mini);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: rgb(243 207 116 / 0.8);
  }

  /* Al bajar, la tapa se levanta y deja ver la primera hoja */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .tapa {
        animation: abrir-tapa linear both;
        animation-timeline: view();
        animation-range: exit 5% exit 85%;
      }
    }
  }

  @keyframes abrir-tapa {
    to {
      transform: rotateX(-68deg) translateY(-6%);
      opacity: 0.2;
    }
  }

  @media (min-width: 48rem) {
    .mesa {
      padding-top: calc(7rem + env(safe-area-inset-top));
    }
  }

  .pagina {
    display: grid;
    gap: 1.5rem;
    max-width: 52rem;
    margin-inline: auto;
    padding: 0.25rem var(--margen) 0;
  }

  /* ---------- Las hojas: papel con un tinte dorado y un fondo de seguridad, como las de un pasaporte ---------- */
  .hoja-pasaporte {
    position: relative;
    padding: 22px 20px 24px;
    border-radius: 18px;
    background:
      repeating-radial-gradient(circle at 100% 0%, transparent 0 22px, color-mix(in srgb, var(--acento) 7%, transparent) 22px 23px),
      repeating-radial-gradient(circle at 0% 100%, transparent 0 30px, color-mix(in srgb, var(--maiz) 9%, transparent) 30px 31px),
      color-mix(in srgb, var(--fondo-elevado) 90%, var(--maiz));
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.4) inset,
      0 16px 34px -24px rgb(40 20 8 / 0.5);
  }

  /* El número de la hoja, en la esquina de abajo */
  .coleccion::after {
    content: attr(data-folio);
    position: absolute;
    right: 18px;
    bottom: 10px;
    font-family: var(--fuente-titulos);
    font-size: 0.875rem;
    font-style: italic;
    color: var(--texto-3);
  }

  /* ---------- El avance ---------- */
  .resumen {
    display: grid;
    gap: 12px;
  }

  .resumen__cifra {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--fuente-titulos);
    font-weight: 600;
  }

  .resumen__cifra strong {
    font-size: clamp(4.5rem, 3rem + 6vw, 6.5rem);
    font-weight: 600;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--acento);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .resumen__cifra span {
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.8rem);
    font-style: italic;
    font-weight: 500;
  }

  .resumen__como {
    font-size: var(--t-nota);
    color: var(--texto-2);
  }

  .resumen__barra {
    height: 8px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--texto) 10%, transparent);
    overflow: hidden;
  }

  .resumen__barra span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--acento);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .resumen__texto {
    color: var(--texto-2);
  }

  .resumen__texto a {
    color: var(--acento);
    font-weight: 600;
  }

  /* ---------- Cada colección, como una página del pasaporte ---------- */
  .coleccion {
    display: grid;
    gap: 14px;
  }

  .coleccion__cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    padding-inline: 4px;
  }

  .coleccion__cabeza h2 {
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .coleccion__cabeza h2 a {
    color: inherit;
    text-decoration: none;
  }

  .coleccion__cuenta {
    font-size: var(--t-nota);
    font-weight: 600;
    color: var(--texto-2);
    font-variant-numeric: tabular-nums;
  }

  .coleccion__completa {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px 3px 6px;
    border-radius: var(--radio-capsula);
    background: var(--acento);
    color: var(--sobre-acento);
    font-size: var(--t-mini);
    font-weight: 700;
  }

  .coleccion__completa[hidden],
  .coleccion__compartir[hidden] {
    display: none;
  }

  .coleccion__compartir {
    margin-left: auto;
  }

  .sellos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.25rem, 1fr));
    gap: 6px;
    padding: 0;
    list-style: none;
  }

  .hueco {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 8px 4px 10px;
    border-radius: var(--radio-s);
    color: var(--texto);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .hueco :global(.sello) {
    width: 84px;
  }

  .hueco:active {
    background: color-mix(in srgb, var(--texto) 6%, transparent);
  }

  .hueco__nombre {
    font-size: var(--t-mini);
    line-height: 1.25;
    text-align: center;
    color: var(--texto-2);
  }

  .hueco:global(.sello-ganado) .hueco__nombre {
    color: var(--texto);
    font-weight: 600;
  }

  /* ---------- Copia de seguridad ---------- */
  .copia {
    display: grid;
    gap: 12px;
    padding: 18px;
    border-radius: var(--radio-m);
    background: var(--fondo-elevado);
  }

  .copia p {
    line-height: 1.45;
  }

  .copia__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .copia__etiqueta {
    margin-top: 8px;
    font-size: var(--t-nota);
    font-weight: 600;
  }

  .copia textarea {
    width: 100%;
    padding: 12px 14px;
    border: 0;
    border-radius: var(--radio-s);
    background: color-mix(in srgb, var(--texto) 7%, transparent);
    color: var(--texto);
    font: 0.9375rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
    resize: vertical;
  }

  .copia__archivo {
    position: relative;
    overflow: hidden;
  }

  .copia__archivo input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .copia__aviso {
    font-size: var(--t-nota);
    font-weight: 600;
    color: var(--acento);
  }

  .copia__aviso:empty {
    display: none;
  }
</style>
