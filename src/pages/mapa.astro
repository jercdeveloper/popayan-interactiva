---
/**
 * El mapa de Popayán a pantalla completa, con una hoja de vidrio que se arrastra entre tres alturas.
 * La hoja lista los lugares (con búsqueda, filtros y orden por cercanía) y muestra el detalle de cada uno.
 * Sin señal: las teselas propias se guardan con el botón "Guardar el mapa".
 */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { CATEGORIAS, aMapa } from '../lib/lugares';
import { fotoDe } from '../lib/fotos';

const lugares = await Promise.all(
  (await getCollection('lugares'))
    .sort((a, b) => a.data.nombre.localeCompare(b.data.nombre, 'es'))
    .map(async (l) => {
      const foto = fotoDe(l.id);
      return {
        ...aMapa(l),
        etiqueta: CATEGORIAS[l.data.categoria].singular,
        icono: CATEGORIAS[l.data.categoria].icono,
        foto: foto ? (await getImage({ src: foto.src, width: 720, format: 'webp' })).src : null,
        miniatura: foto ? (await getImage({ src: foto.src, width: 96, height: 96, fit: 'cover', format: 'webp' })).src : null,
      };
    }),
);
const presentes = new Set(lugares.map((l) => l.categoria));
const categorias = (Object.keys(CATEGORIAS) as (keyof typeof CATEGORIAS)[]).filter((c) => presentes.has(c));
---

<Base titulo="Mapa" seccion="mapa" descripcion="Los lugares del Centro Histórico de Popayán y sus alrededores en un mapa que funciona sin señal." pantallaCompleta>
  <div class="lienzo" data-lienzo data-lugares={JSON.stringify(lugares)} role="region" aria-label="Mapa de Popayán"></div>

  <button type="button" class="cerca vidrio" data-cerca aria-label="Mostrar dónde estoy">
    <Icono nombre="navigation-arrow" />
  </button>

  <section class="hoja vidrio" data-hoja aria-label="Lugares">
    <div class="hoja__agarre" data-agarre>
      <span class="hoja__asa" aria-hidden="true"></span>
      <label class="buscar">
        <Icono nombre="magnifying-glass" />
        <span class="solo-lector">Buscar un lugar</span>
        <input type="search" placeholder="Buscar un lugar" autocomplete="off" data-buscar />
      </label>
      <div class="filtros" role="group" aria-label="Filtrar por tipo">
        <button type="button" aria-pressed="true" data-categoria="">Todo</button>
        {categorias.map((c) => <button type="button" aria-pressed="false" data-categoria={c}>{CATEGORIAS[c].plural}</button>)}
      </div>
    </div>

    <div class="hoja__cuerpo" data-cuerpo>
      <ul class="lista" data-lista>
        {
          lugares.map((l) => (
            <li data-id={l.id} data-categoria={l.categoria} data-nombre={l.nombre}>
              <button type="button" class="lista__item" data-elegir={l.id}>
                {l.miniatura ? (
                  <img class="lista__foto" src={l.miniatura} alt="" width="48" height="48" loading="lazy" decoding="async" />
                ) : (
                  <span class="lista__punto" aria-hidden="true">
                    <Icono nombre={l.icono} />
                  </span>
                )}
                <span class="lista__texto">
                  <span class="lista__nombre">{l.nombre}</span>
                  <span class="lista__meta">
                    {l.etiqueta} · {l.epoca}
                    <span class="lista__distancia" data-distancia />
                  </span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>

      <ul class="celdas extras" data-extras>
        <li>
          <button type="button" class="celda" data-guardar hidden>
            <Icono nombre="download-simple" class="celda__icono" />
            <span class="celda__texto">
              <span data-guardar-texto>Guardar el mapa</span>
              <small>Para usarlo sin señal: unos 2 MB</small>
            </span>
          </button>
        </li>
      </ul>

      <article class="detalle" data-detalle hidden>
        <div class="detalle__texto">
          <p class="detalle__meta" data-detalle-meta></p>
          <h2 data-detalle-nombre></h2>
          <p data-detalle-resumen></p>
          <div class="detalle__acciones">
            <a class="boton boton--lleno" href="/" data-detalle-ficha>Ver la ficha</a>
            <button type="button" class="boton boton--tinte" data-volver>Todos los lugares</button>
          </div>
        </div>
        <div class="detalle__foto-caja" data-detalle-foto hidden></div>
      </article>
    </div>
  </section>
</Base>

<script>
  import * as maplibregl from 'maplibre-gl';
  import urlWorker from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';
  import 'maplibre-gl/dist/maplibre-gl.css';
  import { animate } from 'motion';
  import { estiloMapa, PALETA_VIDRIO } from '../lib/estilo-mapa';
  import fuente from '../lib/mapa-fuente.json';

  interface Lugar {
    id: string;
    nombre: string;
    categoria: string;
    etiqueta: string;
    epoca: string;
    resumen: string;
    coordenadas: [number, number];
    foto: string | null;
    miniatura: string | null;
  }

  if (import.meta.env.PROD) maplibregl.setWorkerUrl(urlWorker);
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const oscuro = matchMedia('(prefers-color-scheme: dark)');
  const color = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();

  const lienzo = document.querySelector<HTMLElement>('[data-lienzo]')!;
  const lugares: Lugar[] = JSON.parse(lienzo.dataset.lugares ?? '[]');
  const porId = new Map(lugares.map((l) => [l.id, l]));

  // ---------- El mapa ----------
  const CENTRO = { sur: 2.432, norte: 2.452, oeste: -76.618, este: -76.596 };
  const centro = lugares.filter(({ coordenadas: [lat, lon] }) => lat >= CENTRO.sur && lat <= CENTRO.norte && lon >= CENTRO.oeste && lon <= CENTRO.este);
  const encuadre = new maplibregl.LngLatBounds();
  for (const l of centro) encuadre.extend([l.coordenadas[1], l.coordenadas[0]]);

  const mapa = new maplibregl.Map({
    container: lienzo,
    style: estiloMapa(oscuro.matches ? 'oscuro' : 'claro', location.origin, PALETA_VIDRIO),
    bounds: encuadre,
    fitBoundsOptions: { padding: { top: 90, bottom: 260, left: 30, right: 30 }, maxZoom: 16.5 },
    maxBounds: [
      [fuente.area.oeste, fuente.area.sur],
      [fuente.area.este, fuente.area.norte],
    ],
    minZoom: 10,
    maxZoom: 19,
    attributionControl: { compact: true },
    dragRotate: false,
    pitchWithRotate: false,
  });
  mapa.touchZoomRotate.disableRotation();

  const datos = {
    type: 'FeatureCollection' as const,
    features: lugares.map((l, i) => ({
      type: 'Feature' as const,
      id: i,
      properties: { id: l.id, nombre: l.nombre, categoria: l.categoria },
      geometry: { type: 'Point' as const, coordinates: [l.coordenadas[1], l.coordenadas[0]] },
    })),
  };

  function capas() {
    mapa.addSource('lugares', { type: 'geojson', data: datos });
    mapa.addLayer({
      id: 'lugares-punto',
      type: 'circle',
      source: 'lugares',
      paint: {
        'circle-radius': ['case', ['boolean', ['feature-state', 'elegido'], false], 11, 7],
        'circle-color': color('--acento'),
        'circle-stroke-width': 3,
        'circle-stroke-color': '#ffffff',
      },
    });
    mapa.addLayer({
      id: 'lugares-nombre',
      type: 'symbol',
      source: 'lugares',
      minzoom: 15.5,
      layout: {
        'text-field': ['get', 'nombre'],
        'text-font': ['Noto Sans Medium'],
        'text-size': 12,
        'text-offset': [0, 1.2],
        'text-anchor': 'top',
        'text-max-width': 9,
      },
      paint: { 'text-color': color('--texto'), 'text-halo-color': color('--fondo-elevado'), 'text-halo-width': 1.6 },
    });
  }
  mapa.on('load', capas);
  oscuro.addEventListener('change', () => {
    mapa.setStyle(estiloMapa(oscuro.matches ? 'oscuro' : 'claro', location.origin, PALETA_VIDRIO));
    mapa.once('style.load', capas);
  });
  mapa.on('click', 'lugares-punto', (e) => {
    const id = e.features?.[0]?.properties?.id;
    if (id) elegir(id);
  });
  mapa.on('mouseenter', 'lugares-punto', () => (mapa.getCanvas().style.cursor = 'pointer'));
  mapa.on('mouseleave', 'lugares-punto', () => (mapa.getCanvas().style.cursor = ''));

  // ---------- La hoja: tres alturas, resortes, inercia y resistencia en los bordes ----------
  const hoja = document.querySelector<HTMLElement>('[data-hoja]')!;
  const agarre = document.querySelector<HTMLElement>('[data-agarre]')!;
  const cuerpo = document.querySelector<HTMLElement>('[data-cuerpo]')!;

  let y = 0;
  let control: ReturnType<typeof animate> | null = null;
  const ALTO_BARRA = 96;

  /** Posiciones de la hoja (desplazamiento hacia abajo desde su altura completa) */
  function alturas() {
    const alto = hoja.offsetHeight;
    // Abajo se ven el asa, el buscador y los filtros por encima de la barra de pestañas
    return { abajo: alto - 154 - ALTO_BARRA, medio: alto * 0.42, arriba: 0 };
  }

  function aplicar(valor: number) {
    y = valor;
    hoja.style.transform = `translate3d(0, ${valor}px, 0)`;
    // Cuanto más sube, más sólida: arriba es una superficie de lectura, abajo un control que flota
    const { abajo } = alturas();
    const solidez = 1 - Math.min(1, Math.max(0, valor / abajo));
    hoja.style.setProperty('--solidez', solidez.toFixed(3));
    cuerpo.style.overflowY = valor <= 1 ? 'auto' : 'hidden';
  }

  function irA(destino: number, velocidad = 0) {
    control?.stop();
    if (quieto) {
      aplicar(destino);
      return;
    }
    const conInercia = Math.abs(velocidad) > 300;
    control = animate(y, destino, {
      type: 'spring',
      // Sin rebote para lo que se pide con un toque; un poco si el dedo lanzó la hoja
      bounce: conInercia ? 0.18 : 0,
      duration: 0.42,
      velocity: velocidad,
      onUpdate: aplicar,
    });
  }

  // Proyección de Apple: adónde llegaría el gesto si siguiera desacelerando como un desplazamiento
  const proyectar = (v: number, d = 0.998) => ((v / 1000) * d) / (1 - d);
  const resistir = (exceso: number, dimension: number, c = 0.55) =>
    (exceso * dimension * c) / (dimension + c * Math.abs(exceso));

  let inicioY = 0;
  let inicioPuntero = 0;
  let historia: { y: number; t: number }[] = [];
  let arrastrando = false;

  agarre.addEventListener('pointerdown', (e) => {
    if ((e.target as HTMLElement).closest('input, button')) return;
    control?.stop(); // se puede agarrar en pleno movimiento, desde donde está
    arrastrando = true;
    agarre.setPointerCapture(e.pointerId);
    inicioY = y;
    inicioPuntero = e.clientY;
    historia = [{ y: e.clientY, t: e.timeStamp }];
  });

  agarre.addEventListener('pointermove', (e) => {
    if (!arrastrando) return;
    const { abajo } = alturas();
    let siguiente = inicioY + (e.clientY - inicioPuntero);
    if (siguiente < 0) siguiente = -resistir(-siguiente, hoja.offsetHeight);
    if (siguiente > abajo) siguiente = abajo + resistir(siguiente - abajo, hoja.offsetHeight);
    aplicar(siguiente);
    historia.push({ y: e.clientY, t: e.timeStamp });
    historia = historia.filter((p) => e.timeStamp - p.t < 100);
  });

  const soltar = (e: PointerEvent) => {
    if (!arrastrando) return;
    arrastrando = false;
    const primero = historia[0];
    const dt = (e.timeStamp - primero.t) / 1000;
    const velocidad = dt > 0 ? (e.clientY - primero.y) / dt : 0;
    const proyectado = y + proyectar(velocidad);
    const puntos = Object.values(alturas());
    const destino = puntos.reduce((a, b) => (Math.abs(b - proyectado) < Math.abs(a - proyectado) ? b : a));
    irA(destino, velocidad);
  };
  agarre.addEventListener('pointerup', soltar);
  agarre.addEventListener('pointercancel', soltar);

  // Un toque en el asa alterna entre abajo y el medio
  agarre.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.hoja__asa')) {
      const { abajo, medio } = alturas();
      irA(Math.abs(y - abajo) < 4 ? medio : abajo);
    }
  });

  aplicar(alturas().abajo);
  addEventListener('resize', () => aplicar(Math.min(y, alturas().abajo)));

  // Al escribir en el buscador, la hoja sube para mostrar los resultados
  const buscar = document.querySelector<HTMLInputElement>('[data-buscar]')!;
  buscar.addEventListener('focus', () => irA(alturas().arriba));

  // ---------- Lista, filtros y búsqueda ----------
  const lista = document.querySelector<HTMLElement>('[data-lista]')!;
  const sinTildes = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  let categoria = '';
  function filtrar() {
    const q = sinTildes(buscar.value.trim());
    for (const li of lista.querySelectorAll<HTMLElement>('li')) {
      const coincide = (!categoria || li.dataset.categoria === categoria) && (!q || sinTildes(li.dataset.nombre ?? '').includes(q));
      li.hidden = !coincide;
    }
    if (mapa.getLayer('lugares-punto')) {
      const f = categoria ? ['==', ['get', 'categoria'], categoria] : null;
      mapa.setFilter('lugares-punto', f as never);
      mapa.setFilter('lugares-nombre', f as never);
    }
  }
  buscar.addEventListener('input', filtrar);
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-categoria]')) {
    b.addEventListener('click', () => {
      categoria = b.dataset.categoria ?? '';
      for (const o of document.querySelectorAll<HTMLButtonElement>('[data-categoria]')) o.setAttribute('aria-pressed', String(o === b));
      filtrar();
      const visibles = lugares.filter((l) => !categoria || l.categoria === categoria);
      if (visibles.length) {
        const caja = new maplibregl.LngLatBounds();
        for (const l of visibles) caja.extend([l.coordenadas[1], l.coordenadas[0]]);
        mapa.fitBounds(caja, { padding: { top: 90, bottom: 260, left: 40, right: 40 }, maxZoom: 16, duration: quieto ? 0 : 700 });
      }
    });
  }

  // ---------- Detalle de un lugar ----------
  const detalle = document.querySelector<HTMLElement>('[data-detalle]')!;
  const extras = document.querySelector<HTMLElement>('[data-extras]')!;
  const cajaFoto = document.querySelector<HTMLElement>('[data-detalle-foto]')!;
  let elegido: number | null = null;

  function elegir(id: string) {
    const l = porId.get(id);
    if (!l) return;
    const indice = lugares.indexOf(l);
    if (elegido !== null) mapa.setFeatureState({ source: 'lugares', id: elegido }, { elegido: false });
    mapa.setFeatureState({ source: 'lugares', id: indice }, { elegido: true });
    elegido = indice;
    detalle.querySelector('[data-detalle-nombre]')!.textContent = l.nombre;
    detalle.querySelector('[data-detalle-meta]')!.textContent = `${l.etiqueta} · ${l.epoca}`;
    detalle.querySelector('[data-detalle-resumen]')!.textContent = l.resumen;
    detalle.querySelector<HTMLAnchorElement>('[data-detalle-ficha]')!.href = `/lugares/${l.id}`;
    // La foto se crea solo si el lugar la tiene: nunca una imagen vacía
    cajaFoto.replaceChildren();
    cajaFoto.hidden = !l.foto;
    if (l.foto) {
      const img = new Image();
      img.className = 'detalle__foto';
      img.alt = '';
      img.decoding = 'async';
      img.src = l.foto;
      cajaFoto.append(img);
    }
    lista.hidden = true;
    extras.hidden = true;
    detalle.hidden = false;
    cuerpo.scrollTop = 0;
    irA(alturas().medio);
    mapa.easeTo({
      center: [l.coordenadas[1], l.coordenadas[0]],
      zoom: Math.max(mapa.getZoom(), l.categoria === 'hacienda' ? 13 : 16.5),
      padding: { top: 60, bottom: hoja.offsetHeight * 0.52, left: 0, right: 0 },
      duration: quieto ? 0 : 800,
    });
  }

  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-elegir]')) {
    b.addEventListener('click', () => elegir(b.dataset.elegir!));
  }
  document.querySelector('[data-volver]')!.addEventListener('click', () => {
    detalle.hidden = true;
    lista.hidden = false;
    extras.hidden = false;
    if (elegido !== null) mapa.setFeatureState({ source: 'lugares', id: elegido }, { elegido: false });
    elegido = null;
  });

  // ---------- Cerca de ti: la ubicación se usa en el teléfono y no sale de él ----------
  document.querySelector('[data-cerca]')!.addEventListener('click', () => {
    navigator.geolocation?.getCurrentPosition(
      ({ coords }) => {
        mapa.flyTo({ center: [coords.longitude, coords.latitude], zoom: 16, duration: quieto ? 0 : 900 });
        ordenarPorCercania(coords.latitude, coords.longitude);
      },
      () => {},
      { enableHighAccuracy: true, timeout: 10000 },
    );
  });

  // ---------- Orden por cercanía (la ubicación se usa en el teléfono y no sale de él) ----------
  function distancia([lat1, lon1]: [number, number], [lat2, lon2]: [number, number]) {
    const r = Math.PI / 180;
    const a =
      Math.sin(((lat2 - lat1) * r) / 2) ** 2 +
      Math.cos(lat1 * r) * Math.cos(lat2 * r) * Math.sin(((lon2 - lon1) * r) / 2) ** 2;
    return 2 * 6_371_000 * Math.asin(Math.sqrt(a));
  }
  function ordenarPorCercania(lat: number, lon: number) {
    const filas = [...lista.querySelectorAll<HTMLElement>('li')];
    const medidas = new Map(filas.map((li) => [li, distancia([lat, lon], porId.get(li.dataset.id!)!.coordenadas)]));
    filas.sort((a, b) => medidas.get(a)! - medidas.get(b)!);
    for (const li of filas) {
      const m = medidas.get(li)!;
      li.querySelector('[data-distancia]')!.textContent =
        m < 1000
          ? ` · a ${Math.round(m / 10) * 10} m`
          : ` · a ${(m / 1000).toLocaleString('es-CO', { maximumFractionDigits: 1 })} km`;
      lista.append(li);
    }
    irA(alturas().medio);
  }

  // ---------- Abrir un lugar desde un enlace (/mapa?lugar=la-ermita) ----------
  const pedido = new URLSearchParams(location.search).get('lugar');
  if (pedido && porId.has(pedido)) mapa.once('load', () => elegir(pedido));

  // ---------- Guardar el mapa completo para usarlo sin señal (lo sirve después el service worker) ----------
  const guardar = document.querySelector<HTMLButtonElement>('[data-guardar]')!;
  const textoGuardar = document.querySelector<HTMLElement>('[data-guardar-texto]')!;
  if ('caches' in window && navigator.serviceWorker?.controller) {
    fetch('/mapa/indice.json')
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then(async ({ cache: nombreCache, archivos }: { cache: string; archivos: string[] }) => {
        const cache = await caches.open(nombreCache);
        guardar.hidden = false;
        if ((await cache.keys()).length >= archivos.length) {
          textoGuardar.textContent = 'Mapa guardado';
          guardar.disabled = true;
          return;
        }
        guardar.addEventListener('click', async () => {
          guardar.disabled = true;
          let listos = 0;
          for (let i = 0; i < archivos.length; i += 8) {
            await Promise.all(
              archivos.slice(i, i + 8).map(async (url) => {
                if (!(await cache.match(url))) {
                  const respuesta = await fetch(url);
                  if (respuesta.ok) await cache.put(url, respuesta);
                }
                listos++;
              }),
            );
            textoGuardar.textContent = `Guardando… ${Math.round((listos / archivos.length) * 100)} %`;
          }
          textoGuardar.textContent = 'Mapa guardado';
        });
      })
      .catch(() => {});
  }
</script>

<style>
  .lienzo {
    position: fixed;
    inset: 0;
  }

  /* Los controles de MapLibre se suman al lenguaje del vidrio */
  .lienzo :global(.maplibregl-ctrl-attrib) {
    background: var(--vidrio-tinte);
    -webkit-backdrop-filter: var(--vidrio-desenfoque);
    backdrop-filter: var(--vidrio-desenfoque);
    border-radius: var(--radio-capsula);
    font: 500 0.6875rem var(--fuente);
    color: var(--texto-2);
  }

  .lienzo :global(.maplibregl-ctrl-top-right),
  .lienzo :global(.maplibregl-ctrl-bottom-right) {
    top: calc(56px + env(safe-area-inset-top));
    bottom: auto;
  }

  .cerca {
    position: fixed;
    z-index: 15;
    left: 12px;
    top: calc(12px + env(safe-area-inset-top));
    display: grid;
    place-items: center;
    width: var(--tactil);
    height: var(--tactil);
    border: 0;
    border-radius: 50%;
    color: var(--acento);
    cursor: pointer;
  }

  .cerca :global(svg) {
    width: 22px;
    height: 22px;
  }

  /* ---------- La hoja ---------- */
  .hoja {
    --solidez: 0;
    position: fixed;
    z-index: 20;
    left: 8px;
    right: 8px;
    top: calc(64px + env(safe-area-inset-top));
    bottom: 8px;
    display: flex;
    flex-direction: column;
    border-radius: var(--radio-l);
    /* Abajo deja ver el mapa; arriba se vuelve casi sólida para leer */
    background: color-mix(in srgb, var(--vidrio-tinte-fuerte) calc(var(--solidez) * 100%), var(--vidrio-tinte));
    will-change: transform;
    touch-action: none;
  }

  .hoja__agarre {
    display: grid;
    gap: 10px;
    padding: 8px 14px 12px;
    cursor: grab;
    touch-action: none;
  }

  .hoja__agarre:active {
    cursor: grabbing;
  }

  .hoja__asa {
    justify-self: center;
    width: 38px;
    height: 5px;
    border-radius: 3px;
    background: var(--texto-3);
    cursor: pointer;
  }

  .buscar {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 12px;
    border-radius: var(--radio-s);
    background: color-mix(in srgb, var(--texto) 8%, transparent);
    color: var(--texto-2);
  }

  .buscar input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--texto);
    font: 400 var(--t-cuerpo) var(--fuente);
    outline: none;
  }

  .buscar input::placeholder {
