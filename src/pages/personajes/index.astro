---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Encabezado from '../../components/vidrio/Encabezado.astro';
import { fotoDe } from '../../lib/fotos';
import Retrato from '../../components/Retrato.astro';

// En el orden en que nacieron
const personajes = (await getCollection('personajes')).sort((a, b) => a.data.nacimiento.anio - b.data.nacimiento.anio);
const anios = (p: (typeof personajes)[number]) =>
  p.data.muerte ? `${p.data.nacimiento.anio}–${p.data.muerte.anio}` : `Nació en ${p.data.nacimiento.anio}`;
---

<Base
  titulo="Personajes"
  descripcion="Personas de la historia de Popayán, de la conquista al siglo XX: científicos, próceres, poetas, presidentas y líderes indígenas, con sus lugares en la ciudad."
>
  <Encabezado
    foto={fotoDe('panteon-de-los-proceres')}
    alt="El Panteón de los Próceres"
    ancho="medio"
    titulo="Personajes"
    bajada="Gente de Popayán y su historia, en el orden en que nacieron, y los lugares de la ciudad donde todavía se los encuentra."
  />

  <div class="pagina">
    <ol class="personas">
      {
        personajes.map((p) => (
          <li>
            <a class="persona revelar" href={`/personajes/${p.id}`}>
              <Retrato foto={fotoDe(`personaje-${p.id}`)} iniciales={p.data.iniciales} />
              <span class="persona__texto">
                <span class="persona__nombre">{p.data.nombre}</span>
                <span class="persona__meta">
                  {anios(p)} · {p.data.oficio}
                </span>
                <span class="persona__resumen">{p.data.resumen}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <section class="pendiente" aria-labelledby="titulo-pendiente">
      <h2 id="titulo-pendiente">Faltan voces</h2>
      <p>
        Esta lista todavía cuenta poco de las mujeres y nada de la gente afrodescendiente de Popayán: de las personas
        esclavizadas en sus haciendas y minas, y de quienes lucharon por su libertad. Esas historias las queremos contar
        con las comunidades y con quienes las han estudiado, no desde afuera. Si conoces a alguien que deba estar aquí, escríbenos
        desde <a href="/acerca">Acerca</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  .pagina {
    display: grid;
    gap: 2.25rem;
    max-width: 46rem;
    margin-inline: auto;
    padding: 0.25rem var(--margen) 0;
  }

  /* Una pared de sala: los retratos colgados en fila, con su cartela debajo */
  .personas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 16px;
    padding: 0;
    list-style: none;
  }

  .persona {
    display: grid;
    align-content: start;
    gap: 14px;
    color: var(--texto);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .persona :global(.retrato__marco) {
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (hover: hover) {
    .persona:hover :global(.retrato__marco) {
      transform: translateY(-4px) rotate(-0.6deg);
    }
  }

  .persona:active :global(.retrato__marco) {
    transform: scale(0.98);
  }

  .persona__texto {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .persona__nombre {
    font-family: var(--fuente-titulos);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.01em;
  }

  @media (min-width: 48rem) {
    .personas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem 24px;
    }
  }

  .persona__meta {
    font-size: var(--t-mini);
    font-weight: 600;
    color: var(--acento);
    font-variant-numeric: tabular-nums;
  }

  .persona__resumen {
    display: -webkit-box;
    margin-top: 2px;
    overflow: hidden;
    font-size: var(--t-nota);
    line-height: 1.4;
    color: var(--texto-2);
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .pendiente {
    display: grid;
    gap: 8px;
    padding: 18px 20px;
    border-radius: var(--radio-m);
    box-shadow: inset 0 0 0 1.5px var(--separador);
  }

  .pendiente h2 {
    font-family: var(--fuente);
    font-size: var(--t-nota);
    font-weight: 700;
  }

  .pendiente p {
    font-size: var(--t-nota);
    line-height: 1.5;
    color: var(--texto-2);
  }

  .pendiente a {
    color: var(--acento);
    font-weight: 600;
  }
</style>
