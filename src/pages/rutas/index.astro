---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Encabezado from '../../components/vidrio/Encabezado.astro';
import Icono from '../../components/Icono.astro';
import { rutasOrdenadas, formatearDuracion, formatearDistancia } from '../../lib/rutas';
import { fotoDe, lineaCredito } from '../../lib/fotos';

const rutas = (await rutasOrdenadas()).map((r) => ({ ...r, foto: fotoDe(r.ruta.data.foto) }));
---

<Base titulo="Rutas" seccion="rutas" descripcion="Rutas por el Centro Histórico de Popayán y sus haciendas, con historias que citan sus fuentes.">
  <Encabezado
    titulo="Rutas"
    bajada="Elige una y la guía te lleva de parada en parada, con la historia de cada lugar. Siete se hacen a pie por el centro; la de las haciendas, en carro."
  />

  <ol class="rutas">
    {
      rutas.map(({ ruta, paradas, metros, minutos, foto }) => (
        <li>
          <a class="ruta" href={`/rutas/${ruta.id}`}>
            {foto && (
              <Picture
                src={foto.src}
                formats={['avif', 'webp']}
                widths={[480, 800, 1200]}
                sizes="(min-width: 64rem) 36rem, (min-width: 48rem) 46vw, 92vw"
                alt=""
                class="ruta__foto"
              />
            )}
            <span class="ruta__texto vidrio">
              <span class="ruta__modo">
                <Icono nombre={ruta.data.modo === 'carro' ? 'car-simple' : 'footprints'} peso="fill" />
                {ruta.data.modo === 'carro' ? 'En carro' : 'A pie'}
              </span>
              <span class="ruta__nombre">{ruta.data.nombre}</span>
              <span class="ruta__lema">{ruta.data.lema}</span>
              <span class="ruta__datos">
                {paradas.length} paradas · {formatearDistancia(metros)} · {formatearDuracion(minutos)}
              </span>
            </span>
            {foto && <span class="solo-lector">Foto: {lineaCredito(foto.credito)}</span>}
          </a>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .rutas {
    display: grid;
    gap: 16px;
    max-width: var(--ancho-max);
    margin-inline: auto;
    padding: 0.5rem var(--margen) 0;
    list-style: none;
  }

  .ruta {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--radio-l);
    overflow: hidden;
    isolation: isolate;
    background: var(--acento);
    color: var(--texto);
    text-decoration: none;
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.5);
    transition: transform 160ms ease-out;
    -webkit-tap-highlight-color: transparent;
  }

  .ruta:active {
    transform: scale(0.985);
  }

  .ruta :global(.ruta__foto) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (hover: hover) {
    .ruta:hover :global(.ruta__foto) {
      transform: scale(1.04);
    }
  }

  .ruta__texto {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    display: grid;
    gap: 4px;
    padding: 16px 18px 18px;
    border-radius: var(--radio-m);
  }

  .ruta__modo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--t-mini);
    font-weight: 600;
    color: var(--acento);
  }

  .ruta__nombre {
    font-family: var(--fuente-titulos);
    font-size: var(--t-titulo);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.022em;
  }

  .ruta__lema {
    font-size: var(--t-nota);
    line-height: 1.35;
    color: var(--texto-2);
  }

  .ruta__datos {
    margin-top: 4px;
    font-size: var(--t-mini);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 30rem) {
    .ruta {
      aspect-ratio: 4 / 3;
    }
  }

  @media (min-width: 48rem) {
    .rutas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
    .ruta {
      aspect-ratio: 5 / 4;
    }
  }
</style>
