---
/**
 * Cabecera fotográfica a sangre, con el título sobre un velo que solo existe para leerlo.
 * Arriba flotan los controles de la página (slot "controles"), en círculos de vidrio.
 * El título manda y los datos van debajo, como el pie de una foto de revista; nunca un rótulo encima.
 * Si el lugar no tiene foto libre, la cabecera es un campo de color de la ciudad con el ícono de su tipo:
 * nunca una foto de otro lugar ni una imagen inventada.
 */
import { Picture } from 'astro:assets';
import Icono from '../Icono.astro';
import { lineaCredito, type Foto } from '../../lib/fotos';

interface Props {
  foto: Foto | null;
  alt: string;
  titulo: string;
  meta?: string;
  /** Ícono para la cabecera sin foto */
  icono?: string;
  /** Cuánto alto ocupa: la portada de una ruta es más alta que la de una ficha */
  alto?: 'grande' | 'media';
  /** El campo de color de la cabecera sin foto: teja (lo de la ciudad), morro (la naturaleza), cantera (la historia) */
  campo?: 'teja' | 'morro' | 'cantera' | 'noche';
  /** Nombre para que la foto viaje desde la tarjeta que trajo hasta aquí (ver public/js/transicion.js) */
  transicion?: string;
  /** Una o dos líneas bajo el título */
  bajada?: string;
  /** El ancho de la columna de la página que sigue, para alinear el título con ella */
  ancho?: 'angosto' | 'medio' | 'ancho';
}

const { foto, alt, titulo, meta, icono = 'map-pin', alto = 'media', campo = 'teja', transicion, bajada, ancho } = Astro.props;
---

<header
  class:list={[
    'cabecera',
    `cabecera--${alto}`,
    ancho && `cabecera--${ancho}`,
    { 'cabecera--sin-foto': !foto, [`cabecera--${campo}`]: !foto },
  ]}
>
  {
    foto ? (
      <>
        <Picture
          src={foto.src}
          formats={['avif', 'webp']}
          widths={[640, 1024, 1600]}
          sizes="100vw"
          alt={alt}
          class="cabecera__foto"
          loading="eager"
          fetchpriority="high"
          data-transicion={transicion}
        />
        <div class="cabecera__velo" aria-hidden="true" />
      </>
    ) : (
      <div class="cabecera__icono" aria-hidden="true">
        <Icono nombre={icono} />
      </div>
    )
  }

  <div class="cabecera__controles">
    <slot name="controles" />
  </div>

  <div class="cabecera__texto">
    <h1>{titulo}</h1>
    {meta && <p class="cabecera__meta">{meta}</p>}
    {bajada && <p class="cabecera__bajada">{bajada}</p>}
    <slot />
  </div>

  {
    foto && (
      <a class="cabecera__credito" href={foto.credito.fuente} rel="noopener noreferrer">
        Foto: {lineaCredito(foto.credito)}
      </a>
    )
  }
</header>

<style>
  .cabecera {
    position: relative;
    display: grid;
    align-content: end;
    min-height: min(68svh, 640px);
    padding: calc(5rem + env(safe-area-inset-top)) var(--margen) 3.6rem;
    color: #fff;
    isolation: isolate;
    overflow: hidden;
  }

  .cabecera--grande {
    min-height: min(80svh, 780px);
  }

  .cabecera :global(.cabecera__foto) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cabecera__velo {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(20 10 6 / 0.74), rgb(20 10 6 / 0.28) 46%, transparent 70%),
      linear-gradient(to bottom, rgb(0 0 0 / 0.28), transparent 26%);
  }

  /* Sin foto: un campo de color de la ciudad, igual en los dos temas, con el ícono grande en relieve */
  .cabecera--sin-foto {
    min-height: min(54svh, 500px);
  }

  .cabecera--teja {
    background: radial-gradient(120% 90% at 15% 0%, rgb(255 255 255 / 0.14), transparent 60%), var(--teja);
  }

  .cabecera--morro {
    background: radial-gradient(120% 90% at 15% 0%, rgb(255 255 255 / 0.12), transparent 60%), var(--morro);
  }

  .cabecera--cantera {
    background: radial-gradient(120% 90% at 15% 0%, rgb(255 255 255 / 0.12), transparent 60%), var(--cantera);
  }

  .cabecera--noche {
    background: radial-gradient(70% 90% at 85% 100%, rgb(255 138 92 / 0.3), transparent 65%), var(--noche);
  }

  .cabecera__icono {
    position: absolute;
    z-index: -1;
    right: -2rem;
    top: 2.5rem;
    color: rgb(255 255 255 / 0.14);
  }

  .cabecera__icono :global(svg) {
    width: clamp(14rem, 40vw, 24rem);
    height: auto;
  }

  .cabecera__controles {
    position: absolute;
    top: calc(12px + env(safe-area-inset-top));
    left: var(--margen);
    /* A la derecha queda el botón de tema, que flota en todas las páginas */
    right: calc(var(--margen) + var(--tactil) + 10px);
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }

  .cabecera__texto {
    display: grid;
    gap: 12px;
    width: 100%;
    max-width: var(--ancho-max);
    margin-inline: auto;
  }

  .cabecera--angosto .cabecera__texto {
    max-width: calc(42rem - 2 * var(--margen));
  }

  .cabecera--medio .cabecera__texto {
    max-width: calc(46rem - 2 * var(--margen));
  }

  .cabecera--ancho .cabecera__texto {
    max-width: calc(52rem - 2 * var(--margen));
  }

  .cabecera h1 {
    max-width: 14ch;
    font-size: clamp(2.8rem, 1.5rem + 5.8vw, 5.75rem);
    line-height: 0.96;
    letter-spacing: -0.02em;
  }

  /* Los datos van debajo del título, tras un filete corto, como el pie de una foto */
  .cabecera__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: var(--t-nota);
    font-weight: 600;
    color: rgb(255 255 255 / 0.9);
  }

  .cabecera__meta::before {
    content: '';
    width: 28px;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    opacity: 0.7;
  }

  .cabecera__bajada {
    max-width: 34rem;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.42;
    color: rgb(255 255 255 / 0.9);
  }

  /* El borde de la hoja: el contenido sube sobre la foto como una hoja, con las esquinas redondas */
  .cabecera::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 26px;
    border-radius: 26px 26px 0 0;
    background: var(--fondo);
  }

  /* Al bajar, la foto se queda atrás y se oscurece, y el título se va: el contenido toma el relevo */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .cabecera :global(.cabecera__foto),
      .cabecera__icono {
        animation: cabecera-foto linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
      .cabecera__texto {
        animation: cabecera-texto linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 70%;
      }
    }
  }

  @keyframes cabecera-foto {
    to {
      transform: translateY(30%) scale(1.08);
      filter: brightness(0.55);
    }
  }

  @keyframes cabecera-texto {
    to {
      transform: translateY(-48px);
      opacity: 0;
    }
  }

  .cabecera__credito {
    position: absolute;
    z-index: 1;
    right: var(--margen);
    bottom: 2.4rem;
    max-width: 60%;
    font-size: 0.6875rem;
    color: rgb(255 255 255 / 0.78);
    text-align: right;
    text-decoration: none;
  }

  /* En escritorio, los controles bajan para no chocar con la barra de pestañas de arriba */
  @media (min-width: 48rem) {
    .cabecera {
      padding-top: calc(6.5rem + env(safe-area-inset-top));
    }
    .cabecera__controles {
      top: calc(80px + env(safe-area-inset-top));
      right: var(--margen);
    }
  }
</style>
