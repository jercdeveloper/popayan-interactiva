---
/**
 * El mapa de una ruta: las paradas numeradas y el trazado aproximado entre ellas.
 * Con `trazado`, la línea sigue las calles (las procesiones) y lleva flechas con el sentido del recorrido.
 * Va dentro de una página que se desplaza, así que pide dos dedos (o Ctrl y la rueda) para moverse
 * y no le roba el desplazamiento a la página. Tocar una parada lleva a ella en la lista.
 */
import type { LugarMapa } from '../../lib/lugares';

interface Props {
  paradas: LugarMapa[];
  etiqueta: string;
  /** La línea por las calles, como [latitud, longitud]; sin ella se unen las paradas en línea recta */
  trazado?: [number, number][];
  /** Paradas numeradas y enlazadas a la lista (las rutas) o solo con su nombre (las procesiones) */
  numerada?: boolean;
}

const { paradas, etiqueta, trazado, numerada = true } = Astro.props;
---

<div
  class="mapa-ruta"
  data-mapa-ruta={JSON.stringify(paradas)}
  data-trazado={trazado ? JSON.stringify(trazado) : undefined}
  data-numerada={String(numerada)}
>
  <div class="mapa-ruta__lienzo" role="region" aria-label={etiqueta}></div>
</div>

<script>
  import urlWorker from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';
  import fuente from '../../lib/mapa-fuente.json';
  import type { LugarMapa } from '../../lib/lugares';

  const oscuro = matchMedia('(prefers-color-scheme: dark)');
  // Las páginas de Semana Santa van de noche aunque el teléfono esté en tema claro
  const tema = () => (document.documentElement.hasAttribute('data-noche') || oscuro.matches ? 'oscuro' : 'claro');
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const color = (variable: string) => getComputedStyle(document.documentElement).getPropertyValue(variable).trim();

  // MapLibre pesa cerca de 1 MB: no se descarga con la página, así la ficha de la ruta se lee de
  // inmediato. Empieza a bajar con el primer desplazamiento y el mapa se monta al acercarse a la pantalla.
  let pedido: Promise<[typeof import('maplibre-gl'), typeof import('../../lib/estilo-mapa'), unknown]> | null = null;
  const cargar = () =>
    (pedido ??= Promise.all([
      import('maplibre-gl'),
      import('../../lib/estilo-mapa'),
      import('maplibre-gl/dist/maplibre-gl.css'),
    ]));
  addEventListener('scroll', cargar, { once: true, passive: true });

  async function montar(contenedor: HTMLElement) {
    const [maplibregl, { estiloMapa, PALETA_VIDRIO }] = await cargar();
    // En producción se usa el worker empaquetado; en desarrollo MapLibre lo encuentra por sí mismo
    if (import.meta.env.PROD) maplibregl.setWorkerUrl(urlWorker);

    const paradas: LugarMapa[] = JSON.parse(contenedor.dataset.mapaRuta ?? '[]');
    const puntos = paradas.map((p) => [p.coordenadas[1], p.coordenadas[0]] as [number, number]);
    const trazado: [number, number][] | null = contenedor.dataset.trazado ? JSON.parse(contenedor.dataset.trazado) : null;
    const linea = trazado ? trazado.map(([lat, lon]) => [lon, lat] as [number, number]) : puntos;
    const numerada = contenedor.dataset.numerada !== 'false';
    const encuadre = new maplibregl.LngLatBounds();
    for (const p of [...puntos, ...linea]) encuadre.extend(p);

    const mapa = new maplibregl.Map({
      container: contenedor.querySelector<HTMLElement>('.mapa-ruta__lienzo')!,
      style: estiloMapa(tema(), location.origin, PALETA_VIDRIO),
      bounds: encuadre,
      fitBoundsOptions: { padding: 48, maxZoom: 17 },
      maxBounds: [
        [fuente.area.oeste, fuente.area.sur],
        [fuente.area.este, fuente.area.norte],
      ],
      minZoom: 10,
      maxZoom: 19,
      attributionControl: { compact: true },
      cooperativeGestures: true,
      locale: {
        'CooperativeGesturesHandler.WindowsHelpText': 'Usa Ctrl y la rueda para acercar el mapa',
        'CooperativeGesturesHandler.MacHelpText': 'Usa ⌘ y la rueda para acercar el mapa',
        'CooperativeGesturesHandler.MobileHelpText': 'Usa dos dedos para mover el mapa',
      },
      dragRotate: false,
      pitchWithRotate: false,
    });
    mapa.touchZoomRotate.disableRotation();

    function capas() {
      mapa.addSource('trazado', {
        type: 'geojson',
        data: { type: 'Feature', properties: {}, geometry: { type: 'LineString', coordinates: linea } },
      });
      mapa.addLayer({
        id: 'trazado',
        type: 'line',
        source: 'trazado',
        layout: { 'line-cap': 'round', 'line-join': 'round' },
        // Por las calles, la línea es continua; en línea recta entre paradas, punteada (es aproximada)
        paint: trazado
          ? { 'line-color': color('--acento'), 'line-width': 7 }
          : { 'line-color': color('--acento'), 'line-width': 3.5, 'line-dasharray': [1.4, 1.6] },
      });
      if (trazado) {
        // Un chevrón blanco dibujado aquí mismo, que apunta hacia donde avanza la procesión
        if (!mapa.hasImage('flecha')) {
          const lienzo = document.createElement('canvas');
          lienzo.width = lienzo.height = 32;
          const ctx = lienzo.getContext('2d')!;
          ctx.strokeStyle = '#ffffff';
          ctx.lineWidth = 5;
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';
          ctx.beginPath();
          ctx.moveTo(11, 8);
          ctx.lineTo(20, 16);
          ctx.lineTo(11, 24);
          ctx.stroke();
          mapa.addImage('flecha', ctx.getImageData(0, 0, 32, 32), { pixelRatio: 2 });
        }
        mapa.addLayer({
          id: 'trazado-sentido',
          type: 'symbol',
          source: 'trazado',
          layout: {
            'symbol-placement': 'line',
            'symbol-spacing': 56,
            'icon-image': 'flecha',
            'icon-rotation-alignment': 'map',
            'icon-allow-overlap': true,
            'icon-ignore-placement': true,
          },
        });
      }
      mapa.addSource('paradas', {
        type: 'geojson',
        data: {
          type: 'FeatureCollection',
          features: paradas.map((p, i) => ({
            type: 'Feature',
            id: i,
            properties: { orden: String(i + 1), nombre: p.nombre },
            geometry: { type: 'Point', coordinates: puntos[i] },
          })),
        },
      });
      mapa.addLayer({
        id: 'paradas-punto',
        type: 'circle',
        source: 'paradas',
        paint: {
          'circle-radius': numerada ? 13 : 9,
          'circle-color': color('--acento'),
          'circle-stroke-width': 3,
          'circle-stroke-color': '#ffffff',
        },
      });
      if (numerada) mapa.addLayer({
        id: 'paradas-numero',
        type: 'symbol',
        source: 'paradas',
        layout: {
          'text-field': ['get', 'orden'],
          'text-font': ['Noto Sans Medium'],
          'text-size': 13,
          'text-allow-overlap': true,
          'text-ignore-placement': true,
        },
        paint: { 'text-color': '#ffffff' },
      });
      mapa.addLayer({
        id: 'paradas-nombre',
        type: 'symbol',
        source: 'paradas',
        minzoom: numerada ? 16 : 0,
        layout: {
          'text-field': ['get', 'nombre'],
          'text-font': ['Noto Sans Medium'],
          'text-size': 12,
          'text-offset': [0, 1.5],
          'text-anchor': 'top',
          'text-max-width': 9,
          'text-optional': true,
        },
        paint: { 'text-color': color('--texto'), 'text-halo-color': color('--fondo-elevado'), 'text-halo-width': 1.6 },
      });
    }
    mapa.on('load', capas);
    oscuro.addEventListener('change', () => {
      mapa.setStyle(estiloMapa(tema(), location.origin, PALETA_VIDRIO));
      mapa.once('style.load', capas);
    });

    // Tocar una parada lleva a su lugar en la lista
    mapa.on('click', 'paradas-punto', (e) => {
      if (!numerada) return;
      const indice = e.features?.[0]?.id;
      if (typeof indice !== 'number') return;
      const destino = document.getElementById(`parada-${indice + 1}`);
      destino?.scrollIntoView({ behavior: quieto ? 'auto' : 'smooth', block: 'center' });
      destino?.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    });
    mapa.on('mouseenter', 'paradas-punto', () => (mapa.getCanvas().style.cursor = 'pointer'));
    mapa.on('mouseleave', 'paradas-punto', () => (mapa.getCanvas().style.cursor = ''));
  }

  const vigia = new IntersectionObserver(
    (entradas) => {
      for (const entrada of entradas) {
        if (!entrada.isIntersecting) continue;
        vigia.unobserve(entrada.target);
        montar(entrada.target as HTMLElement);
      }
    },
    { rootMargin: '100px 0px' },
  );
  for (const contenedor of document.querySelectorAll<HTMLElement>('[data-mapa-ruta]')) vigia.observe(contenedor);
</script>

<style>
  .mapa-ruta {
    position: relative;
    height: clamp(18rem, 52vh, 30rem);
    border-radius: var(--radio-l);
    overflow: hidden;
    isolation: isolate;
    background: var(--fondo-elevado);
  }

  .mapa-ruta__lienzo {
    position: absolute;
    inset: 0;
  }

  .mapa-ruta :global(.maplibregl-ctrl-attrib) {
    background: color-mix(in srgb, var(--fondo-elevado) 85%, transparent);
    color: var(--texto-2);
  }

  .mapa-ruta :global(.maplibregl-ctrl-attrib a) {
    color: var(--texto-2);
  }

  .mapa-ruta :global(.maplibregl-cooperative-gesture-screen) {
    font-family: var(--fuente);
    font-size: var(--t-nota);
    font-weight: 600;
  }
</style>
