---
/**
 * El título de una página. Con foto, es una cabecera a sangre como la de las fichas (el título sobre la
 * ciudad, y la página sube como una hoja); sin foto, es un título grande, como los títulos grandes de iOS.
 */
import CabeceraFoto from './CabeceraFoto.astro';
import type { Foto } from '../../lib/fotos';

interface Props {
  titulo: string;
  bajada?: string;
  /** El ancho de la columna de la página, para que el título quede alineado con lo que sigue */
  ancho?: 'angosto' | 'medio' | 'ancho';
  foto?: Foto | null;
  /** Qué se ve en la foto, para quien no la ve */
  alt?: string;
}

const { titulo, bajada, ancho, foto, alt = '' } = Astro.props;
---

{
  foto ? (
    <CabeceraFoto foto={foto} alt={alt} titulo={titulo} bajada={bajada} ancho={ancho}>
      <slot />
    </CabeceraFoto>
  ) : (
    <header class:list={['encabezado', ancho && `encabezado--${ancho}`]}>
      <h1>{titulo}</h1>
      {bajada && <p>{bajada}</p>}
      <slot />
    </header>
  )
}

<style>
  .encabezado {
    display: grid;
    gap: 0.6rem;
    max-width: var(--ancho-max);
    margin-inline: auto;
    padding: calc(3.25rem + env(safe-area-inset-top)) var(--margen) 1.25rem;
  }

  .encabezado--angosto {
    max-width: 42rem;
  }

  .encabezado--medio {
    max-width: 46rem;
  }

  .encabezado--ancho {
    max-width: 52rem;
  }

  .encabezado h1 {
    font-size: var(--t-gigante);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }

  .encabezado p {
    max-width: 36rem;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    color: var(--texto-2);
  }

  @media (min-width: 48rem) {
    .encabezado {
      padding-top: calc(7.5rem + env(safe-area-inset-top));
    }
  }
</style>
