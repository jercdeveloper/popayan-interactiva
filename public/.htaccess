# Popayán Interactiva en SiteGround (Apache, con NGINX delante para los archivos estáticos).
# La política de seguridad de contenido (CSP) la genera Astro como etiqueta meta en cada página;
# aquí van las cabeceras que una etiqueta meta no puede dar.
# Ojo: NGINX puede poner sus propias cabeceras de caché a los archivos estáticos. Después de cada
# cambio de servidor, revisa las respuestas con `curl -I` (ver README).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Las páginas viven en carpetas (rutas/index.html) y los enlaces no llevan barra final:
# /rutas se sirve directamente, sin redirigir a /rutas/
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Siempre por HTTPS (la regla que documenta SiteGround)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Una sola dirección: sin www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

  # /rutas → rutas/index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ $1/index.html [L]
</IfModule>

# Tipos que Apache no siempre conoce
AddType application/manifest+json .webmanifest
AddType application/x-protobuf .pbf

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml application/x-protobuf
</IfModule>

<IfModule mod_headers.c>
  # Seguridad (docs/revision-tecnica.md §4.1)
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=(), usb=()"
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always set X-Frame-Options "DENY"

  # Las páginas y el service worker siempre se revisan, para que las actualizaciones lleguen enseguida
  <FilesMatch "\.html$|^sw\.js$|^indice\.json$|^manifest\.webmanifest$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Archivos con huella en el nombre: se guardan un año
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # El mapa cambia solo cuando se vuelve a extraer
  <If "%{REQUEST_URI} =~ m#^/mapa/(teselas|fuentes)/#">
    Header set Cache-Control "public, max-age=2592000"
  </If>

  # Las tarjetas para compartir se regeneran en cada publicación
  <If "%{REQUEST_URI} =~ m#^/tarjetas/#">
    Header set Cache-Control "public, max-age=86400"
  </If>
</IfModule>
